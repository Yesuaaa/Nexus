# Copy to .env beside compose.yaml. Docker Compose reads this file automatically.
WEB_PORT=5173
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Required server-only random JWT key; see docs/session.md for generation.
JWT_SECRET=

# Copy the runtime connection URL from Supabase > Connect. Leave empty for an API-only smoke test.
# Runtime: Transaction pooler (port 6543), with pgbouncer=true and sslmode=verify-full.
# The API image includes the Supabase 2021 root CA for certificate verification.
DATABASE_URL=

# Server-only Supabase Storage configuration for service images.
# The API creates or reconciles this public bucket on the first upload. Never expose the secret key to the web app.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_SERVICE_IMAGES_BUCKET=service-images
