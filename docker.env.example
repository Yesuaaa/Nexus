# Copy to .env beside compose.yaml. Docker Compose reads this file automatically.
WEB_PORT=5173
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3001

# Optional provider credentials for API sign-in. Configure exact callbacks in each provider console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Apple requires a registered HTTPS API callback; use a stable HTTPS tunnel for local testing.
APPLE_PRIVATE_KEY=
# Used only when a provider does not supply a verified email.
RESEND_API_KEY=
EMAIL_FROM="Nexus <login@example.com>"

# Copy the runtime connection URL from Supabase > Connect. Leave empty for an API-only smoke test.
# Runtime: Transaction pooler (port 6543), with pgbouncer=true and sslmode=verify-full.
# The API image includes the Supabase 2021 root CA for certificate verification.
DATABASE_URL=
