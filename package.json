{
  "name": "nexus-starter",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "audit:dependencies": "pnpm audit --audit-level high",
    "dev": "pnpm -r --parallel dev",
    "dev:mobile": "node -e \"const { spawnSync } = require('node:child_process'); const result = spawnSync('adb', ['reverse', 'tcp:3001', 'tcp:3001'], { stdio: 'ignore' }); if (result.error || result.status !== 0) console.warn('ADB reverse skipped; install Android platform-tools and connect an emulator/device for mobile API access.');\" && pnpm --filter @nexus/api dev",
    "dev:mobile:docker": "node scripts/run-mobile-docker.mjs",
    "run:mobile": "node scripts/run-mobile-app.mjs",
    "docker:mobile:test": "docker compose -f compose.yaml -f compose.mobile.yaml run --rm mobile-test",
    "docker:mobile:build": "docker compose -f compose.yaml -f compose.mobile.yaml run --rm mobile-build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/tests/run-all.mjs",
    "test:unit": "node scripts/tests/run-all.mjs --no-e2e",
    "test:api": "node scripts/tests/run-api.mjs",
    "test:web": "node scripts/tests/run-web.mjs",
    "test:e2e": "node scripts/tests/run-e2e.mjs",
    "test:postman": "node scripts/run-postman.mjs",
    "start:api": "pnpm --filter @nexus/api start",
    "start:web": "pnpm --filter @nexus/web start",
    "preview:web": "pnpm --filter @nexus/web preview",
    "db:generate": "pnpm --filter @nexus/api db:generate",
    "db:migrate": "pnpm --filter @nexus/api db:migrate",
    "db:studio": "pnpm --filter @nexus/api db:studio",
    "test:mobile": "node scripts/run-mobile-regression.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "lucide-react": "^1.61.0"
  }
}
