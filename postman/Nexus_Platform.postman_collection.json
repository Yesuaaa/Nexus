            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"EMP-2026-099\",\n  \"fullName\": \"Alex Rivera\",\n  \"email\": \"alex.rivera@example.com\",\n  \"position\": \"Senior UI/UX Specialist\",\n  \"departmentId\": \"{{department_id}}\",\n  \"employmentType\": \"FULL_TIME\",\n  \"createAccount\": true,\n  \"password\": \"SecurePass123!\",\n  \"role\": \"STAFF\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees",
