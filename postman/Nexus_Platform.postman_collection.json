{
  "info": {
    "_postman_id": "nexus-api-collection-v2",
    "name": "Nexus Platform API (Web & Mobile)",
    "description": "Complete Postman collection for the Nexus Capstone Platform. Covers Authentication, Mobile Client Journey, Administrative Operations, Messaging, and Workflows. Automatically handles JWT token assignment upon login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Authentication Diagnostics",
      "description": "Run only this folder, in order, with a disposable development account. Creates and revokes its own login session. Stops on assertion failure.",
      "item": [
        {
          "name": "01 Login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"token\", \"\");",
                  "pm.environment.set(\"refreshToken\", \"\");",
                  "pm.environment.set(\"diagnosticAccessToken\", \"\");",
                  "pm.environment.set(\"diagnosticRefreshToken\", \"\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"token\", \"\");",
                  "pm.environment.set(\"refreshToken\", \"\");",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "let resData;",
                  "try { resData = pm.response.json(); } catch { resData = null; }",
                  "const valid = resData && typeof resData.token === \"string\" && /^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/.test(resData.token) && typeof resData.refreshToken === \"string\" && /^[A-Za-z0-9_-]{43}$/.test(resData.refreshToken) && Number.isInteger(resData.expiresIn) && resData.expiresIn > 0;",
                  "pm.test(\"Response contains a valid token pair and lifetime\", () => pm.expect(Boolean(valid)).to.equal(true));",
                  "if (pm.response.code === 200 && valid) {",
                  "  pm.environment.set(\"token\", resData.token);",
                  "  pm.environment.set(\"refreshToken\", resData.refreshToken);",
                  "}",
                  "if (pm.test.index() > 0) {",
                  "  if (pm.response.code !== 200 || !valid) pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Signs in user and writes 'token' and 'refreshToken' into Postman Environment."
          }
        },
        {
          "name": "02 Me before refresh",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.test.index() > 0) {",
                  "  if (pm.response.code !== 200) pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Rotate refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const previousRefreshToken = pm.environment.get(\"refreshToken\");",
                  "pm.environment.set(\"token\", \"\");",
                  "pm.environment.set(\"refreshToken\", \"\");",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "let resData;",
                  "try { resData = pm.response.json(); } catch { resData = null; }",
                  "const valid = resData && typeof resData.token === \"string\" && /^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/.test(resData.token) && typeof resData.refreshToken === \"string\" && /^[A-Za-z0-9_-]{43}$/.test(resData.refreshToken) && Number.isInteger(resData.expiresIn) && resData.expiresIn > 0;",
                  "pm.test(\"Response contains a valid token pair and lifetime\", () => pm.expect(Boolean(valid)).to.equal(true));",
                  "const rotated = valid && resData.refreshToken !== previousRefreshToken;",
                  "pm.test(\"Refresh token rotates\", () => pm.expect(Boolean(rotated)).to.equal(true));",
                  "if (pm.response.code === 200 && valid && rotated) {",
                  "  pm.environment.set(\"token\", resData.token);",
                  "  pm.environment.set(\"refreshToken\", resData.refreshToken);",
                  "}",
                  "if (pm.test.index() > 0) {",
                  "  if (pm.response.code !== 200 || !valid || !rotated) pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Rotates refresh token and returns a fresh access JWT."
          }
        },
        {
          "name": "04 Me after refresh",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.test.index() > 0) {",
                  "  if (pm.response.code !== 200) pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"diagnosticAccessToken\", pm.environment.get(\"token\"));",
                  "pm.environment.set(\"diagnosticRefreshToken\", pm.environment.get(\"refreshToken\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
                  "if (pm.response.code === 204) {",
                  "pm.environment.set(\"token\", \"\");",
                  "pm.environment.set(\"refreshToken\", \"\");",
                  "}",
                  "if (pm.test.index() > 0) {",
                  "  if (pm.response.code !== 204) pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Revoked access rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{diagnosticAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Revoked access returns 401\", () => pm.response.to.have.status(401));",
                  "if (pm.test.index() > 0) {",
                  "  if (pm.response.code !== 401) pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Revoked refresh rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Revoked refresh returns 401\", () => pm.response.to.have.status(401));",
                  "pm.environment.set(\"diagnosticAccessToken\", \"\");",
                  "pm.environment.set(\"diagnosticRefreshToken\", \"\");",
                  "if (pm.test.index() > 0) {",
                  "  if (pm.response.code !== 401) pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{diagnosticRefreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Rotates refresh token and returns a fresh access JWT."
          }
        }
      ]
    },
