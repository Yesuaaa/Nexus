  employee               Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeNumberSnapshot String
  employeeNameSnapshot   String
  employmentTypeSnapshot EmploymentType
  status                 PayrollRunItemStatus
  currency               String                    @default("PHP") @db.Char(3)
  grossAmount            Decimal?                  @db.Decimal(14, 2)
  deductionsAmount       Decimal?                  @db.Decimal(14, 2)
  netAmount              Decimal?                  @db.Decimal(14, 2)
  compensationSnapshot   Json
  attendanceSnapshot     Json
  warnings               Json
  blocks                 Json
