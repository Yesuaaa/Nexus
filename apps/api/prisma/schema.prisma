  requestedBy       User                   @relation("LeaveRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  routeDepartmentId String?
  verifiedById      String?
  verifiedBy        User?                  @relation("LeaveVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  verifiedAt        DateTime?              @db.Timestamptz(3)
