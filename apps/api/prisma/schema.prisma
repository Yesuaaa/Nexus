  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  periods        PayrollPeriod[]

  @@unique([effectiveFrom], map: "payroll_configuration_start_uq")
  @@index([effectiveFrom, effectiveTo], map: "payroll_configuration_effective_idx")
}

model PayrollPeriod {
  id              String               @id @default(cuid())
