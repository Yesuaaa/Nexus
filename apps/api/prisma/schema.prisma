  @@unique([configurationId, startDate, endDate], map: "payroll_period_configuration_boundary_uq")
  @@index([startDate, endDate], map: "payroll_period_date_range_idx")
  @@index([configurationId, startDate], map: "payroll_period_configuration_start_idx")
}

model PayrollRun {
  id               String                  @id @default(cuid())
  periodId         String                  @unique(map: "payroll_run_period_uq")
  period           PayrollPeriod           @relation(fields: [periodId], references: [id], onDelete: Restrict)
  status           PayrollRunStatus        @default(DRAFT)
  calculationCount Int                     @default(0)
  createdById      String
  createdBy        User                    @relation("PayrollRunCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)
  calculations     PayrollRunCalculation[]

  @@index([status, createdAt], map: "payroll_run_status_created_idx")
}

model PayrollRunCalculation {
  reconciliationExceptions PayrollReconciliationException[]
  disbursement        PayrollDisbursementBatch?
  id                  String                    @id @default(cuid())
  runId               String
  run                 PayrollRun                @relation(fields: [runId], references: [id], onDelete: Restrict)
  revision            Int
  status              PayrollCalculationStatus
  calculatedAt        DateTime                  @default(now()) @db.Timestamptz(3)
  createdById         String
  createdBy           User                      @relation("PayrollCalculationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  currency            String                    @default("PHP") @db.Char(3)
  grossTotal          Decimal                   @default(0) @db.Decimal(14, 2)
  deductionsTotal     Decimal                   @default(0) @db.Decimal(14, 2)
  netTotal            Decimal                   @default(0) @db.Decimal(14, 2)
  calculatedItemCount Int                       @default(0)
  reviewItemCount     Int                       @default(0)
  blockedItemCount    Int                       @default(0)
  inputSnapshot       Json
  items               PayrollRunItem[]
  approvalEvents      PayrollApprovalEvent[]

  @@unique([runId, revision], map: "payroll_run_calculation_revision_uq")
  @@index([runId, revision], map: "payroll_run_calculation_history_idx")
  @@index([status, calculatedAt], map: "payroll_run_calculation_status_idx")
}

model PayrollApprovalEvent {
  id            String                    @id @default(cuid())
  calculationId String
  calculation   PayrollRunCalculation     @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  action        WorkforceManagementAction
  actorId       String
  actorName     String?
  reason        String?                   @db.VarChar(500)
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)

  @@unique([calculationId, action])
}

model PayrollRunItem {
  payout                 PayrollDisbursementItem?
  id                     String                    @id @default(cuid())
  calculationId          String
  calculation            PayrollRunCalculation     @relation(fields: [calculationId], references: [id], onDelete: Restrict)
