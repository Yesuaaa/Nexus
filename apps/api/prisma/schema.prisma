generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ExampleItem {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
}

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
  USER
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  UNPAID
  OTHER
}

enum LeaveStatus {
  SUBMITTED
  VERIFIED
  APPROVED
  REJECTED
  CANCELLED
  REVERSED
}

enum LeaveAction {
  SUBMITTED
  VERIFIED
  APPROVED
  REJECTED
  CANCELLED
  REVERSED
}

enum AccountManagementAction {
  CREATED
  PROFILE_UPDATED
  ROLE_CHANGED
  STATUS_CHANGED
  PASSWORD_RESET
  ARCHIVED
  RESTORED
  DELETED
}

enum AccountManagementOrigin {
  ACCOUNT_MANAGEMENT
  CLIENT_MANAGEMENT
  EMPLOYEE_MANAGEMENT
}

enum WorkforceManagementSubject {
  EMPLOYEE
  DEPARTMENT
  TEAM
}

enum WorkforceManagementAction {
  CREATED
  PROFILE_UPDATED
  STATUS_CHANGED
  ASSIGNMENT_CHANGED
  HEAD_CHANGED
  TEMPORARY_HEAD_CHANGED
  LEAD_CHANGED
  TITLE_CLEARED
  DELETED
}

enum WorkforceManagementOrigin {
  ACCOUNT_MANAGEMENT
  EMPLOYEE_MANAGEMENT
  DEPARTMENT_MANAGEMENT
  TEAM_MANAGEMENT
}

// Immutable identity snapshots deliberately have no User/HR foreign keys.
// Domain success writers append within their caller's transaction.
model ServiceOperationLog {
  id            String   @id @default(cuid())
  event         String   @db.VarChar(60)
  action        String?  @db.VarChar(60)
  endpoint      String?  @db.VarChar(160)
  source        String   @db.VarChar(40)
  outcome       String   @db.VarChar(20)
  actorId       String?  @db.VarChar(80)
  actorName     String?  @db.VarChar(100)
  actorRole     Role?
  subjectId     String?  @db.VarChar(80)
  targetType    String?  @db.VarChar(60)
  targetLabel   String?  @db.VarChar(160)
  changes       Json?
  requestId     String?  @db.VarChar(80)
  correlationId String   @db.Uuid
  status        Int?
  failureCode   String?  @db.VarChar(60)
  failureReason String?  @db.VarChar(240)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt, id])
  @@index([outcome, createdAt, id])
  @@index([requestId, createdAt, id])
  @@index([actorId, createdAt, id])
  @@index([correlationId])
}

// Scalar snapshots survive business-record deletion without imposing new foreign keys.
model ProjectManagementLog {
  id            String   @id @default(cuid())
  event         String   @db.VarChar(60)
  source        String   @db.VarChar(40)
  outcome       String   @db.VarChar(20)
  actorId       String?  @db.VarChar(80)
  actorName     String?  @db.VarChar(100)
  actorRole     Role?
  projectId     String?  @db.VarChar(80)
  projectName   String?  @db.VarChar(160)
  workspaceId   String?  @db.VarChar(80)
  targetId      String?  @db.VarChar(80)
  targetLabel   String?  @db.VarChar(160)
  requestId     String?  @db.VarChar(80)
  changes       Json?
  endpoint      String?  @db.VarChar(160)
  correlationId String   @db.Uuid
  status        Int?
  failureCode   String?  @db.VarChar(60)
  failureReason String?  @db.VarChar(240)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt, id])
  @@index([outcome, createdAt, id])
  @@index([actorId, createdAt, id])
  @@index([projectId, createdAt, id])
  @@index([workspaceId, createdAt, id])
  @@index([correlationId])
}

model AccountManagementChange {
  id               String                  @id @default(cuid())
  actorAccountId   String                  @db.VarChar(80)
  actorRoleAtTime  Role
  operationId      String                  @db.Uuid
  subjectAccountId String                  @db.VarChar(80)
  action           AccountManagementAction
  origin           AccountManagementOrigin
  changedFields    String[]
  changes          Json
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)

  @@index([subjectAccountId, createdAt, id], map: "account_change_subject_time_idx")
  @@index([actorAccountId, createdAt, id], map: "account_change_actor_time_idx")
  @@index([operationId], map: "account_change_operation_idx")
}

model WorkforceManagementChange {
  id              String                     @id @default(cuid())
  actorAccountId  String                     @db.VarChar(80)
  actorRoleAtTime Role
  operationId     String                     @db.Uuid
  subjectType     WorkforceManagementSubject
  subjectId       String                     @db.VarChar(80)
  action          WorkforceManagementAction
  origin          WorkforceManagementOrigin
  changedFields   String[]
  changes         Json
  createdAt       DateTime                   @default(now()) @db.Timestamptz(3)

  @@index([subjectType, subjectId, createdAt, id], map: "workforce_change_subject_time_idx")
  @@index([actorAccountId, createdAt, id], map: "workforce_change_actor_time_idx")
  @@index([operationId], map: "workforce_change_operation_idx")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum ServiceRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  ACTIVATED
  CONCLUDED
  AWAITING_CLIENT_INFO
  READY_FOR_QUOTATION
  CLOSED
  CANCELLED
}

enum PricingModel {
  FIXED
  STARTING
  CUSTOM_QUOTE
  RECURRING
  HOURLY
}

enum BillingInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectDeliverableStatus {
  NOT_SUBMITTED
  IN_REVIEW
  REJECTED
  APPROVED
  SENT_TO_CLIENT
}

enum ProjectDeliverableSubmissionStatus {
  IN_REVIEW
  ESCALATED
  REJECTED
  APPROVED
  SENT_TO_CLIENT
  WITHDRAWN
}

enum ProjectNoteRevisionStatus {
