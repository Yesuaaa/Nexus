generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ExampleItem {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
}

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
  USER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum ServiceRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model User {
  id                                String      @id @default(cuid())
  email                             String      @unique
  fullName                          String?
  contactNumber                     String?
  position                          String?
  passwordHash                      String
  role                              Role        @default(USER)
  isActive                          Boolean     @default(true)
  accountDeletedAt                  DateTime?
  createdAt                         DateTime    @default(now())
  updatedAt                         DateTime    @updatedAt
  departmentId                      String?
  department                        Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  headOf                            Department? @relation("DepartmentHead")
  teamId                            String?
  team                              Team?       @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  leadOfTeam                        Team?       @relation("TeamLead")
  employee                          Employee?
  temporaryOriginalDepartmentHeadOf Department? @relation("DepartmentTemporaryOriginalHead")
  temporaryAssignedDepartmentHeadOf Department? @relation("DepartmentTemporaryAssignedHead")
  sessions                          Session[]
  serviceRequests                   ServiceRequest[]
  projects                          Project[]

  @@index([departmentId])
  @@index([teamId])
  @@index([accountDeletedAt])
}

model Department {
  id                      String     @id @default(cuid())
  name                    String     @unique
  code                    String?    @unique
  description             String?
  headId                  String?    @unique
  head                    User?      @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  temporaryHeadOriginalId String?    @unique
  temporaryHeadOriginal   User?      @relation("DepartmentTemporaryOriginalHead", fields: [temporaryHeadOriginalId], references: [id], onDelete: SetNull)
  temporaryHeadAssignedId String?    @unique
  temporaryHeadAssigned   User?      @relation("DepartmentTemporaryAssignedHead", fields: [temporaryHeadAssignedId], references: [id], onDelete: SetNull)
  members                 User[]     @relation("DepartmentMembers")
  employees               Employee[]
  teams                   Team[]
  services                Service[]  @relation("ServiceDepartments")
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  @@index([headId])
}

model Service {
  id          String       @id @default(cuid())
  name        String       @unique
  description String
  isActive    Boolean      @default(true)
  departments Department[] @relation("ServiceDepartments")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  serviceRequests ServiceRequest[]

  @@index([isActive])
}

model ServiceRequest {
  id          String               @id @default(cuid())
  clientId    String
  client      User                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId   String
  service     Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  title       String
  description String?
  status      ServiceRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([clientId, createdAt, id])
  @@index([serviceId])
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  client      User          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId, createdAt, id])
}

model Team {
  id           String     @id @default(cuid())
  name         String
  description  String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  leadId       String?    @unique
  lead         User?      @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members      User[]     @relation("TeamMembers")
  employees    Employee[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([leadId])
}

model Employee {
  id             String         @id @default(cuid())
  employeeId     String         @unique
  fullName       String
  email          String?
  contactNumber  String?
  position       String?
  employmentType EmploymentType @default(FULL_TIME)
  status         EmployeeStatus @default(ACTIVE)
  startDate      DateTime?
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId         String?
  team           Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  userId         String?        @unique
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([departmentId])
  @@index([teamId])
  @@index([status])
  @@index([employmentType])
  @@index([fullName])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
