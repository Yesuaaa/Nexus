  @@index([departmentId])
  @@index([leadId])
}

model Employee {
  attendanceAdjustments    AttendanceAdjustment[]
  attendanceAudit          AttendanceAudit[]
  attendanceAssignments    AttendancePolicyAssignment[]
  attendanceWorkdays       AttendanceWorkday[]
  leaveRequests            LeaveRequest[]
  leaveRequestDays         LeaveRequestDay[]
  id                       String                       @id @default(cuid())
  employeeId               String                       @unique
  fullName                 String
  email                    String?
  contactNumber            String?
  position                 String?
  employmentType           EmploymentType               @default(FULL_TIME)
  status                   EmployeeStatus               @default(ACTIVE)
  startDate                DateTime?
  departmentId             String?
  department               Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId                   String?
  team                     Team?                        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  userId                   String?                      @unique
  user                     User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  preferredServiceRequests ServiceRequest[]
  profileBio               String?                      @db.VarChar(2000)
  profileImageUrl          String?                      @db.VarChar(2048)
  profileBannerUrl         String?                      @db.VarChar(2048)
