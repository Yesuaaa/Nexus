  @@unique([calculationId, employeeId], map: "payroll_run_item_calculation_employee_uq")
  @@index([calculationId, status], map: "payroll_run_item_status_idx")
  @@index([employeeId, calculationId], map: "payroll_run_item_employee_idx")
}

model PayrollRunItemComponent {
  id            String                        @id @default(cuid())
  itemId        String
