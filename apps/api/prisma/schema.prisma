  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  platform     String   @db.VarChar(40)
  url          String   @db.VarChar(2048)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId, displayOrder], map: "specialist_social_link_order_idx")
}

model Session {
  approximateLocation String?
  userAgent           String?
  lastActiveAt        DateTime?
  id                  String         @id @default(cuid())
  tokenHash           String         @unique
  userId              String
  expiresAt           DateTime
  createdAt           DateTime       @default(now())
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens       RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  sessionId  String
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum AttendanceScheduleMode {
  FLEXIBLE
  FIXED
}

model AttendancePolicy {
  scheduleMode            AttendanceScheduleMode       @default(FLEXIBLE)
  archivedAt              DateTime?                    @db.Timestamptz(3)
  unpaidBreaksEnabled     Boolean                      @default(true)
  overnightRequiresReview Boolean                      @default(false)
  id                      String                       @id @default(cuid())
  name                    String
  timeZone                String
  createdAt               DateTime                     @default(now()) @db.Timestamptz(3)
  days                    AttendancePolicyDay[]
  assignments             AttendancePolicyAssignment[]
}

model AttendancePolicyDay {
  scheduledStartMinute Int?
  scheduledEndMinute Int?
  scheduledUnpaidBreakMinutes Int?
  policyId        String
  policy          AttendancePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  weekday         Int
  isWorkingDay    Boolean
  requiredMinutes Int

  @@id([policyId, weekday])
}

model AttendancePolicyAssignment {
  replacedAssignmentId String?
  replacedUntil        DateTime?           @db.Date
  id                   String              @id @default(cuid())
  employeeId           String
  employee             Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  policyId             String
  policy               AttendancePolicy    @relation(fields: [policyId], references: [id], onDelete: Restrict)
  effectiveFrom        DateTime            @db.Date
  effectiveUntil       DateTime?           @db.Date
  cancelledAt          DateTime?           @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  workdays             AttendanceWorkday[]
  leaveRequestDays     LeaveRequestDay[]

  @@unique([id, employeeId])
  @@index([employeeId, effectiveFrom])
}

model AttendanceWorkday {
  scheduledStartAt        DateTime?                  @db.Timestamptz(3)
  scheduledEndAt          DateTime?                  @db.Timestamptz(3)
  scheduledUnpaidBreakMinutes Int?
  policyName              String
  unpaidBreaksEnabled     Boolean
  overnightRequiresReview Boolean
  id                      String                     @id @default(cuid())
  employeeId              String
  employee                Employee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignmentId            String
  assignment              AttendancePolicyAssignment @relation(fields: [assignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  workDate                DateTime                   @db.Date
  timeZone                String
  isWorkingDay            Boolean
  requiredMinutes         Int
  createdAt               DateTime                   @default(now()) @db.Timestamptz(3)
  sessions                AttendanceWorkSession[]
  audit                   AttendanceAudit[]

  @@unique([employeeId, workDate])
  @@unique([id, employeeId])
}

model AttendanceWorkSession {
  suspendedAt DateTime? @db.Timestamptz(3)
  adjustments AttendanceAdjustment[]
  id          String                 @id @default(cuid())
  // A BEFORE INSERT trigger selects/creates the starting workday if omitted.
  workdayId   String                 @default(dbgenerated())
  employeeId  String
  workday     AttendanceWorkday      @relation(fields: [workdayId, employeeId], references: [id, employeeId], onDelete: Restrict)
  startedAt   DateTime               @db.Timestamptz(3)
  endedAt     DateTime?              @db.Timestamptz(3)
  breaks      AttendanceBreak[]

  @@index([workdayId, startedAt])
  @@index([employeeId, startedAt])
}

model AttendanceBreak {
  id        String                @id @default(cuid())
  sessionId String
  session   AttendanceWorkSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  startedAt DateTime              @db.Timestamptz(3)
  endedAt   DateTime?             @db.Timestamptz(3)
  isPaid    Boolean               @default(false)

  @@index([sessionId, startedAt])
}

model AttendanceAudit {
  writerTransaction String? @default(dbgenerated("pg_current_xact_id()::text"))
  id         String             @id @default(cuid())
  // Stable entity identity and snapshots also cover policy/rule/assignment changes.
  entityType String
  entityId   String
  employeeId String?
  employee   Employee?          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workdayId  String?
  workday    AttendanceWorkday? @relation(fields: [workdayId], references: [id], onDelete: Restrict)
  actorId    String?
  actor      User?              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  reason     String
  before     Json?
  after      Json?
  actionId   String             @unique
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  operationId String?          @db.Uuid
  correlationId String?        @db.Uuid
  actorRoleAtTime Role?

  @@index([workdayId, createdAt])
  @@index([employeeId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt, id])
  @@index([operationId])
}

enum AttendanceAdjustmentStatus {
  PENDING
  VERIFIED
  APPROVED
  REJECTED
}

model AttendanceAdjustment {
  verifiedDepartmentId String?
  notifications        WorkflowNotification[]
  type              String                     @default("CORRECTION") @db.VarChar(20)
  overtimeMinutes   Int                        @default(0)
  verifiedById      String?
  verifiedBy        User?                      @relation("AttendanceVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  verifiedAt        DateTime?                  @db.Timestamptz(3)
  verificationNote  String?                    @db.VarChar(2000)
  id                String                     @id @default(cuid())
  requestKey        String                     @unique
  employeeId        String
  employee          Employee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  sessionId         String?
  session           AttendanceWorkSession?     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  originalSession   Json?
  proposedStartedAt DateTime                   @db.Timestamptz(3)
  proposedEndedAt   DateTime                   @db.Timestamptz(3)
  reason            String                     @db.VarChar(2000)
  status            AttendanceAdjustmentStatus @default(PENDING)
  requestedById     String
  requestedBy       User                       @relation("AttendanceRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById      String?
  reviewedBy        User?                      @relation("AttendanceReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewNote        String?                    @db.VarChar(2000)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  reviewedAt        DateTime?                  @db.Timestamptz(3)

  @@index([employeeId, createdAt, id])
  @@index([status, createdAt, id])
}

enum ServiceInquiryStatus {
  PENDING
  CONTACTED
  CLOSED
  SPAM
}

model ServiceInquiry {
  id String @id @default(cuid())
  serviceId String
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  fullName String @db.VarChar(100)
  email String @db.VarChar(254)
  contactNumber String @db.VarChar(24)
  subject String @db.VarChar(160)
  message String @db.VarChar(6000)
  submissionKey String @unique @db.Uuid
  fingerprint String @db.VarChar(64)
  status ServiceInquiryStatus @default(PENDING)
  internalNote String? @db.VarChar(2000)
  reviewedById String?
  reviewedBy User? @relation("ServiceInquiryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt, id])
  @@index([serviceId, createdAt])
  @@index([email, createdAt])
  @@index([fingerprint, createdAt])
}

enum PayrollRequestType {
  MISSING_PAYSLIP
  PAYSLIP_CORRECTION
  PAYROLL_DISCREPANCY
  MISSING_SALARY_PAYMENT
}

enum PayrollRequestStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

model PayrollPayslip {
  id          String                   @id @default(cuid())
  itemId      String                   @unique
  item        PayrollRunItem           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  reference   String                   @unique
  document    Bytes
  generatedAt DateTime                 @default(now()) @db.Timestamptz(3)
  generatedBy String
  publishedAt DateTime?                @db.Timestamptz(3)
  publishedBy String?
  requests    PayrollEmployeeRequest[]
}

model PayrollEmployeeRequest {
  id                       String                  @id @default(cuid())
  employeeId               String
  employee                 Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payslipId                String?
  payslip                  PayrollPayslip?         @relation(fields: [payslipId], references: [id], onDelete: Restrict)
  type                     PayrollRequestType
  status                   PayrollRequestStatus    @default(OPEN)
  needsFinancialCorrection Boolean                 @default(false)
  createdBy                String
  createdAt                DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @db.Timestamptz(3)
  resolvedAt               DateTime?               @db.Timestamptz(3)
  withdrawnAt              DateTime?               @db.Timestamptz(3)
  withdrawnBy              String?
  messages                 PayrollRequestMessage[]

  @@index([employeeId, createdAt])
  @@index([employeeId, withdrawnAt, createdAt, id])
  @@index([status, type, createdAt])
}

model PayrollRequestMessage {
  id        String                 @id @default(cuid())
  requestId String
  request   PayrollEmployeeRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actorId   String
  isAdmin   Boolean
  body      String                 @db.VarChar(2000)
  createdAt DateTime               @default(now()) @db.Timestamptz(3)

  @@index([requestId, createdAt])
}

model PayrollDisbursementBatch {
  items         PayrollDisbursementItem[]
  id            String                    @id @default(cuid())
  calculationId String                    @unique
  calculation   PayrollRunCalculation     @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  status        PayrollDisbursementStatus @default(DRAFT)
  currency      String                    @default("PHP")
  createdBy     String
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt, id])
}

enum PayrollDisbursementStatus {
  DRAFT
  BLOCKED
  CANCELLED
}

model PayrollDisbursementItem {
  id            String                     @id @default(cuid())
  batchId       String
  batch         PayrollDisbursementBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  payrollItemId String                     @unique
  payrollItem   PayrollRunItem             @relation(fields: [payrollItemId], references: [id], onDelete: Restrict)
  amount        Decimal                    @db.Decimal(14, 2)
  destination   PayrollSandboxDestination?
  attempt       PayrollTransferAttempt?

  @@index([batchId])
}

model PayrollSandboxDestination {
  id        String                        @id @default(cuid())
  itemId    String                        @unique
  item      PayrollDisbursementItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  kind      PayrollSandboxDestinationKind
  lastFour  String                        @db.Char(4)
  createdAt DateTime                      @default(now()) @db.Timestamptz(3)
  createdBy String
}

enum PayrollSandboxDestinationKind {
  TEST_BANK
  TEST_EWALLET
}

model PayrollTransferAttempt {
  id             String                   @id @default(cuid())
  itemId         String                   @unique
  item           PayrollDisbursementItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  idempotencyKey String                   @unique @db.Uuid
  outcome        PayrollSimulationOutcome
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  createdBy      String
}

enum PayrollSimulationOutcome {
  SUCCEEDED
  FAILED
  PENDING
}

enum PayrollReconciliationExceptionStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model PayrollReconciliationException {
  calculationId  String
  calculation    PayrollRunCalculation @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  category       String
  subjectId      String
  status         PayrollReconciliationExceptionStatus @default(OPEN)
  firstEvidence  Json
  lastEvidence   Json
  firstDetectedAt DateTime @db.Timestamptz(3)
  lastObservedAt  DateTime @db.Timestamptz(3)

  version        Int @default(0)
  observed       Boolean @default(true)
  decisions      PayrollReconciliationDecision[]

  @@id([calculationId, category, subjectId])
}

model PayrollReconciliationDecision {
  id             String   @id @default(cuid())
  calculationId  String
  category       String
  subjectId      String
  exception      PayrollReconciliationException @relation(fields: [calculationId, category, subjectId], references: [calculationId, category, subjectId], onDelete: Restrict, map: "payroll_reconcile_decision_exception_fk")
  requestId      String   @db.Uuid
  version        Int
  actorId        String
  action         String
  previous       PayrollReconciliationExceptionStatus
  next           PayrollReconciliationExceptionStatus
  reason         String   @db.VarChar(500)
  classification String?
  assessment     String?
  evidence       Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([calculationId, category, subjectId, requestId], map: "payroll_reconcile_decision_request_uq")
  @@unique([calculationId, category, subjectId, version], map: "payroll_reconcile_decision_version_uq")
}
