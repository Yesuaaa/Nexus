  leaveVersion           Int                   @default(0)
  type                   String?
  summary                String?
  readAt                 DateTime?
  createdAt              DateTime              @default(now())

  @@unique([userId, eventId])
  @@unique([userId, attendanceAdjustmentId, type])
  @@unique([userId, leaveRequestId, type, leaveVersion], map: "WorkflowNotification_leave_version_key")
  @@index([userId, readAt, createdAt])
}

model LeaveRequest {
  id                String                 @id @default(cuid())
  requestKey        String                 @db.Uuid
  employeeId        String
  employee          Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
