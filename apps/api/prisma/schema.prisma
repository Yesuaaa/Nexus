generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ExampleItem {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
}

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
  USER
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  fullName      String?
  contactNumber String?
  position      String?
  passwordHash  String?
  role          Role        @default(USER)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  departmentId  String?
  department    Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  headOf        Department? @relation("DepartmentHead")
  teamId        String?
  team          Team?       @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  leadOfTeam    Team?       @relation("TeamLead")
  sessions      Session[]
  socialIdentities SocialIdentity[]

  @@index([departmentId])
  @@index([teamId])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  description String?
  headId      String?  @unique
  head        User?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  members     User[]   @relation("DepartmentMembers")
  teams       Team[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([headId])
}

model Team {
  id           String     @id @default(cuid())
  name         String
  description  String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  leadId       String?    @unique
  lead         User?      @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members      User[]     @relation("TeamMembers")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([leadId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  reauthenticatedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum SocialProvider {
  google
  facebook
  apple
}

model SocialIdentity {
  id String @id @default(cuid())
  userId String
  provider SocialProvider
  subject String
  email String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, subject])
  @@unique([userId, provider])
}

model OAuthAttempt {
  id String @id
  provider SocialProvider
  purpose String
  verifierHash String
  nonce String
  codeVerifier String
  userId String?
  sessionId String?
  expiresAt DateTime
  @@index([expiresAt])
}

model SocialCompletion {
  id String @id
  provider SocialProvider
  subject String
  email String?
  emailVerified Boolean
  fullName String?
  verifierHash String
  purpose String
  userId String?
  sessionId String?
  expiresAt DateTime
  emailCodeHash String?
  emailCodeExpiresAt DateTime?
  emailCodeAttempts Int @default(0)
  emailSentAt DateTime?
  @@index([expiresAt])
}
