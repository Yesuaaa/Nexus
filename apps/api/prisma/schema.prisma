generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ExampleItem {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
}

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
  USER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum ServiceRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  AWAITING_CLIENT_INFO
  READY_FOR_QUOTATION
  CLOSED
  CANCELLED
}

enum PricingModel {
  FIXED
  STARTING
  CUSTOM_QUOTE
  RECURRING
  HOURLY
}

enum BillingInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum RequestWorkflowState {
  PENDING_REVIEW
  CONSULTATION
  QUOTATION_PENDING
  CLIENT_APPROVAL
  AGREEMENT_PAYMENT_PENDING
  READY_FOR_ACTIVATION
  ACTIVE_PROJECT
  DECLINED
  CANCELLED
  REVISION_REQUESTED
  ON_HOLD
}

enum WorkflowRequirementStatus {
  REQUESTED
  SUBMITTED
  COMPLETED
}

enum WorkflowQuotationStatus {
  PENDING_INTERNAL
  SENT
  ACCEPTED
  DECLINED
  REVISION_REQUESTED
  SUPERSEDED
}

enum WorkflowDocumentStatus {
  PENDING
  SUBMITTED
  APPROVED
}

enum WorkflowPaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
}

enum WorkflowConsultationStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id                                String                  @id @default(cuid())
  email                             String                  @unique
  fullName                          String?
  contactNumber                     String?
  position                          String?
  passwordHash                      String
  role                              Role                    @default(USER)
  isActive                          Boolean                 @default(true)
  accountDeletedAt                  DateTime?
  createdAt                         DateTime                @default(now())
  updatedAt                         DateTime                @updatedAt
  departmentId                      String?
  department                        Department?             @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  headOf                            Department?             @relation("DepartmentHead")
  teamId                            String?
  team                              Team?                   @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  leadOfTeam                        Team?                   @relation("TeamLead")
  employee                          Employee?
  temporaryOriginalDepartmentHeadOf Department?             @relation("DepartmentTemporaryOriginalHead")
  temporaryAssignedDepartmentHeadOf Department?             @relation("DepartmentTemporaryAssignedHead")
  sessions                          Session[]
  serviceRequests                   ServiceRequest[]
  acceptedServiceRequests           ServiceRequest[]        @relation("RequestAcceptedBy")
  requestMessages                   ServiceRequestMessage[]
  projects                          Project[]
  workflowEvents                    WorkflowEvent[]
  workflowFiles                     WorkflowFile[]
  workflowApprovals                 WorkflowApproval[]
  workflowNotifications             WorkflowNotification[]
  quotationApprovalAssignments      RequestWorkflow[]       @relation("WorkflowQuotationApprover")
  paymentVerificationAssignments    RequestWorkflow[]       @relation("WorkflowPaymentVerifier")

  @@index([departmentId])
  @@index([teamId])
  @@index([accountDeletedAt])
}

model Department {
  id                      String           @id @default(cuid())
  name                    String           @unique
  color                   String           @default("blue") @db.VarChar(16)
  code                    String?          @unique
  description             String?
  headId                  String?          @unique
  head                    User?            @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  temporaryHeadOriginalId String?          @unique
  temporaryHeadOriginal   User?            @relation("DepartmentTemporaryOriginalHead", fields: [temporaryHeadOriginalId], references: [id], onDelete: SetNull)
  temporaryHeadAssignedId String?          @unique
  temporaryHeadAssigned   User?            @relation("DepartmentTemporaryAssignedHead", fields: [temporaryHeadAssignedId], references: [id], onDelete: SetNull)
  members                 User[]           @relation("DepartmentMembers")
  employees               Employee[]
  teams                   Team[]
  services                Service[]        @relation("ServiceDepartments")
  acceptedServiceRequests ServiceRequest[] @relation("RequestAcceptedDepartment")
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([headId])
}

model Service {
  id                        String           @id @default(cuid())
  name                      String           @unique
  description               String
  iconKey                   String           @default("sparkles") @db.VarChar(32)
  imagePath                 String?
  imageAltText              String?
  clientRequirements        String[]         @default([])
  requiresConsultation      Boolean          @default(false)
  requiresAgreement         Boolean          @default(true)
  requiresPayment           Boolean          @default(true)
  requiresQuotationApproval Boolean          @default(false)
  consultationNotes         String?
  isActive                  Boolean          @default(true)
  pricingTemplateId         String?
  pricingTemplate           PricingTemplate? @relation(fields: [pricingTemplateId], references: [id], onDelete: SetNull)
  departments               Department[]     @relation("ServiceDepartments")
  keyBenefits               ServiceBenefit[]
  packages                  ServicePackage[]
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  serviceRequests           ServiceRequest[]

  @@index([isActive])
  @@index([pricingTemplateId])
}

model ServiceBenefit {
  id           String  @id @default(cuid())
  serviceId    String
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title        String
  description  String
  displayOrder Int     @default(0)

  @@index([serviceId, displayOrder])
}

model PricingTemplate {
  id              String           @id @default(cuid())
  name            String           @unique
  pricingModel    PricingModel
  currency        String           @default("PHP")
  amount          Decimal?         @db.Decimal(12, 2)
  billingInterval BillingInterval?
  isPublic        Boolean          @default(true)
  services        Service[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([pricingModel])
}

model ServicePackage {
  id               String           @id @default(cuid())
  serviceId        String
  service          Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name             String
  description      String
  includedFeatures String[]         @default([])
  pricingModel     PricingModel
  currency         String           @default("PHP")
  amount           Decimal?         @db.Decimal(12, 2)
  billingInterval  BillingInterval?
  isPricingPublic  Boolean          @default(true)
  isActive         Boolean          @default(true)
  displayOrder     Int              @default(0)
  isRecommended    Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  serviceRequests  ServiceRequest[]

  @@unique([serviceId, name])
  @@index([serviceId, isActive, displayOrder])
}

model ServiceRequest {
  id                      String                  @id @default(cuid())
  referenceNumber         String?                 @unique
  clientId                String
  client                  User                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId               String
  service                 Service                 @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  packageId               String?
  package                 ServicePackage?         @relation(fields: [packageId], references: [id], onDelete: SetNull)
  preferredSpecialistId   String?
  preferredSpecialist     Employee?               @relation(fields: [preferredSpecialistId], references: [id], onDelete: SetNull)
  preferredSpecialistName String?
  title                   String
  description             String?
  requirementsPayload     Json?
  projectGoals            String                  @default("")
  projectRequirements     String                  @default("")
  expectedTimeline        String                  @default("") @db.VarChar(300)
  additionalDetails       String?
  status                  ServiceRequestStatus    @default(SUBMITTED)
  acceptedDepartmentId    String?
  acceptedDepartment      Department?             @relation("RequestAcceptedDepartment", fields: [acceptedDepartmentId], references: [id], onDelete: Restrict)
  acceptedById            String?
  acceptedBy              User?                   @relation("RequestAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  acceptedAt              DateTime?
  clientReadAt            DateTime?
  staffReadAt             DateTime?
  messages                ServiceRequestMessage[]
  workflow                RequestWorkflow?
  project                 Project?
  pricingModel            PricingModel?
  agreedPrice             Decimal?                @db.Decimal(12, 2)
  quotedPrice             Decimal?                @db.Decimal(12, 2)
  currency                String?
  billingInterval         BillingInterval?
  packageName             String?
  submissionKey           String?                 @db.VarChar(36)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([clientId, submissionKey])
  @@index([clientId, createdAt, id])
  @@index([serviceId])
  @@index([packageId])
  @@index([preferredSpecialistId])
  @@index([referenceNumber])
  @@index([acceptedDepartmentId, createdAt])
}

model ServiceRequestMessage {
  id              String         @id @default(cuid())
  requestId       String
  request         ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User           @relation(fields: [senderId], references: [id], onDelete: Restrict)
  clientMessageId String         @db.VarChar(36)
  body            String?        @db.VarChar(4000)
  createdAt       DateTime       @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?
  purgeAt         DateTime?

  @@unique([requestId, senderId, clientMessageId])
  @@index([requestId, createdAt, id])
  @@index([requestId, senderId, createdAt])
  @@index([purgeAt])
}

model Project {
  id          String             @id @default(cuid())
  clientId    String
  client      User               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name        String
  description String?
  status      ProjectStatus      @default(PLANNED)
  startDate   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  requestId   String?            @unique
  request     ServiceRequest?    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  quotationId String?            @unique
  quotation   WorkflowQuotation? @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  staff       ProjectStaff[]
  milestones  ProjectMilestone[]

  @@index([clientId, createdAt, id])
}

model Team {
  id           String     @id @default(cuid())
  name         String
  description  String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  leadId       String?    @unique
  lead         User?      @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members      User[]     @relation("TeamMembers")
  employees    Employee[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([leadId])
}

model Employee {
  id                       String                       @id @default(cuid())
  employeeId               String                       @unique
  fullName                 String
  email                    String?
  contactNumber            String?
  position                 String?
  employmentType           EmploymentType               @default(FULL_TIME)
  status                   EmployeeStatus               @default(ACTIVE)
  startDate                DateTime?
  departmentId             String?
  department               Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId                   String?
  team                     Team?                        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  userId                   String?                      @unique
  user                     User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  preferredServiceRequests ServiceRequest[]
  profileBio               String?                      @db.VarChar(2000)
  profileImageUrl          String?                      @db.VarChar(2048)
  profileSpecialties       String[]                     @default([])
  portfolioProjects        SpecialistPortfolioProject[]
  socialLinks              SpecialistSocialLink[]
  projectAssignments       ProjectStaff[]

  @@index([departmentId])
  @@index([teamId])
  @@index([status])
  @@index([employmentType])
  @@index([fullName])
}

// Workflow records, rather than chat messages, authorize business decisions.
model RequestWorkflow {
  requestId                 String                  @id
  request                   ServiceRequest          @relation(fields: [requestId], references: [id], onDelete: Restrict)
  state                     RequestWorkflowState    @default(CONSULTATION)
  previousState             RequestWorkflowState?
  version                   Int                     @default(1)
  consultationRequired      Boolean                 @default(false)
  agreementRequired         Boolean                 @default(true)
  paymentRequired           Boolean                 @default(true)
  quotationApprovalRequired Boolean                 @default(false)
  quotationApproverId       String?
  quotationApprover         User?                   @relation("WorkflowQuotationApprover", fields: [quotationApproverId], references: [id], onDelete: Restrict)
  paymentVerifierId         String?
  paymentVerifier           User?                   @relation("WorkflowPaymentVerifier", fields: [paymentVerifierId], references: [id], onDelete: Restrict)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  requirements              WorkflowRequirement[]
  files                     WorkflowFile[]
  consultations             WorkflowConsultation[]
  quotations                WorkflowQuotation[]
  approval                  WorkflowApproval?
  agreement                 WorkflowAgreement?
  payment                   WorkflowPayment?
  events                    WorkflowEvent[]
  actions                   WorkflowActionReceipt[]
  notifications             WorkflowNotification[]
}

model WorkflowRequirement {
  id         String                    @id @default(cuid())
  requestId  String
  workflow   RequestWorkflow           @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  title      String                    @db.VarChar(300)
  details    String?                   @db.VarChar(4000)
  mandatory  Boolean                   @default(true)
  status     WorkflowRequirementStatus @default(REQUESTED)
  submission String?                   @db.VarChar(4000)
  fileId     String?
  file       WorkflowFile?             @relation(fields: [fileId], references: [id], onDelete: Restrict)
  reviewNote String?                   @db.VarChar(2000)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  @@index([requestId, createdAt])
}

model WorkflowFile {
  id            String                @id @default(cuid())
  requestId     String
  workflow      RequestWorkflow       @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  uploaderId    String
  uploader      User                  @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  uploadId      String                @db.VarChar(36)
  name          String                @db.VarChar(160)
  mimeType      String                @db.VarChar(100)
  size          Int
  sha256        String                @db.VarChar(64)
  clientVisible Boolean               @default(true)
  data          Bytes
  createdAt     DateTime              @default(now())
  requirements  WorkflowRequirement[]
  agreements    WorkflowAgreement[]   @relation("AgreementDocument")
  signatures    WorkflowAgreement[]   @relation("AgreementSignature")
  payments      WorkflowPayment[]

  @@unique([requestId, uploaderId, uploadId])
  @@index([requestId, createdAt])
}

model WorkflowConsultation {
  id        String                     @id @default(cuid())
  requestId String
  workflow  RequestWorkflow            @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  startsAt  DateTime
  endsAt    DateTime
  location  String                     @db.VarChar(1000)
  notes     String?                    @db.VarChar(2000)
  status    WorkflowConsultationStatus @default(SCHEDULED)
  createdAt DateTime                   @default(now())

  @@index([requestId, startsAt])
}

model WorkflowQuotation {
  id                     String                  @id @default(cuid())
  requestId              String
  workflow               RequestWorkflow         @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  version                Int
  status                 WorkflowQuotationStatus @default(SENT)
  scope                  String                  @db.VarChar(6000)
  deliverables           String[]
  lineItems              Json
  total                  Decimal                 @db.Decimal(12, 2)
  currency               String                  @db.VarChar(3)
  timeline               String                  @db.VarChar(1000)
  paymentTerms           String                  @db.VarChar(2000)
  paymentDue             Decimal                 @db.Decimal(12, 2)
  validUntil             DateTime
  decisionNote           String?                 @db.VarChar(2000)
  createdById            String
  internallyApprovedById String?
  internallyApprovedAt   DateTime?
  publishedAt            DateTime?
  createdAt              DateTime                @default(now())
  approval               WorkflowApproval?
  project                Project?

  @@unique([requestId, version])
}

model WorkflowApproval {
  id           String            @id @default(cuid())
  requestId    String            @unique
  workflow     RequestWorkflow   @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  quotationId  String            @unique
  quotation    WorkflowQuotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  amount       Decimal           @db.Decimal(12, 2)
  currency     String            @db.VarChar(3)
  approvedById String
  approvedBy   User              @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt   DateTime          @default(now())
}

model WorkflowAgreement {
  id             String                 @id @default(cuid())
  requestId      String                 @unique
  workflow       RequestWorkflow        @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  mandatory      Boolean                @default(true)
  status         WorkflowDocumentStatus @default(PENDING)
  documentFileId String?
  documentFile   WorkflowFile?          @relation("AgreementDocument", fields: [documentFileId], references: [id], onDelete: Restrict)
  signedFileId   String?
  signedFile     WorkflowFile?          @relation("AgreementSignature", fields: [signedFileId], references: [id], onDelete: Restrict)
  reviewedById   String?
  reviewedAt     DateTime?
}

model WorkflowPayment {
  id           String                @id @default(cuid())
  requestId    String                @unique
  workflow     RequestWorkflow       @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  mandatory    Boolean               @default(true)
  amount       Decimal               @db.Decimal(12, 2)
  currency     String                @db.VarChar(3)
  status       WorkflowPaymentStatus @default(PENDING)
  proofFileId  String?
  proofFile    WorkflowFile?         @relation(fields: [proofFileId], references: [id], onDelete: Restrict)
  reference    String?               @db.VarChar(300)
  verifiedById String?
  verifiedAt   DateTime?
}

model WorkflowEvent {
  id            String                 @id @default(cuid())
  requestId     String
  workflow      RequestWorkflow        @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  actorId       String?
  actor         User?                  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  type          String                 @db.VarChar(60)
  summary       String                 @db.VarChar(4000)
  entityId      String?
  internal      Boolean                @default(false)
  createdAt     DateTime               @default(now())
  notifications WorkflowNotification[]

  @@index([requestId, createdAt, id])
}

model WorkflowActionReceipt {
  id          String          @id @default(cuid())
  requestId   String
  workflow    RequestWorkflow @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  actorId     String
  actionId    String          @db.VarChar(36)
  payloadHash String          @db.VarChar(64)
  createdAt   DateTime        @default(now())

  @@unique([requestId, actorId, actionId])
}

model WorkflowNotification {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  requestId String
  workflow  RequestWorkflow @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  eventId   String
  event     WorkflowEvent   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  readAt    DateTime?
  createdAt DateTime        @default(now())

  @@unique([userId, eventId])
  @@index([userId, readAt, createdAt])
}

model ProjectStaff {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  approvedById String
  approvedAt   DateTime @default(now())

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

model ProjectMilestone {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  title        String    @db.VarChar(300)
  completedAt  DateTime?
  displayOrder Int       @default(0)

  @@index([projectId, displayOrder])
}

model SpecialistPortfolioProject {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title        String   @db.VarChar(160)
  summary      String   @db.VarChar(3000)
  contribution String?  @db.VarChar(2000)
  thumbnailUrl String?  @db.VarChar(2048)
  projectUrl   String?  @db.VarChar(2048)
  isPublished  Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId, isPublished, displayOrder], map: "specialist_portfolio_published_order_idx")
}

model SpecialistSocialLink {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  platform     String   @db.VarChar(40)
  url          String   @db.VarChar(2048)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId, displayOrder], map: "specialist_social_link_order_idx")
}

model Session {
  id            String         @id @default(cuid())
  tokenHash     String         @unique
  userId        String
  expiresAt     DateTime
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  sessionId  String
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
