model User {
  reviewedServiceInquiries ServiceInquiry[] @relation("ServiceInquiryReviewer")
  attendanceRequests                AttendanceAdjustment[]            @relation("AttendanceRequester")
  attendanceReviews                 AttendanceAdjustment[]            @relation("AttendanceReviewer")
  attendanceVerifications           AttendanceAdjustment[]            @relation("AttendanceVerifier")
  attendanceAudit                   AttendanceAudit[]
  leaveRequests                     LeaveRequest[]                    @relation("LeaveRequester")
  leaveDecisions                    LeaveDecision[]
  leaveVerifications                LeaveRequest[]                    @relation("LeaveVerifier")
  id                                String                            @id @default(cuid())
  email                             String                            @unique
  fullName                          String?
  contactNumber                     String?
  profileImagePath                  String?
  profileBannerPath                 String?
  position                          String?
  settings                          Json                              @default("{}")
  passwordHash                      String
  role                              Role                              @default(USER)
  isActive                          Boolean                           @default(true)
  accountDeletedAt                  DateTime?
  createdAt                         DateTime                          @default(now())
  updatedAt                         DateTime                          @updatedAt
  departmentId                      String?
  department                        Department?                       @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  headOf                            Department?                       @relation("DepartmentHead")
  teamId                            String?
  team                              Team?                             @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  leadOfTeam                        Team?                             @relation("TeamLead")
  employee                          Employee?
  temporaryOriginalDepartmentHeadOf Department?                       @relation("DepartmentTemporaryOriginalHead")
  temporaryAssignedDepartmentHeadOf Department?                       @relation("DepartmentTemporaryAssignedHead")
  sessions                          Session[]
  serviceRequests                   ServiceRequest[]
  acceptedServiceRequests           ServiceRequest[]                  @relation("RequestAcceptedBy")
  requestMessages                   ServiceRequestMessage[]
  requestConversations              RequestConversation[]             @relation("RequestConversationClient")
  conversationDeletions             RequestConversationDeletion[]
  internalConversationsAsFirst      InternalConversation[]            @relation("InternalConversationFirstParticipant")
  internalConversationsAsSecond     InternalConversation[]            @relation("InternalConversationSecondParticipant")
  internalConversationParticipants  InternalConversationParticipant[]
  internalMessages                  InternalMessage[]                 @relation("InternalMessageSender")
  projectMessages                   ProjectMessage[]
  projectConversationReads          ProjectConversationRead[]
  projects                          Project[]
  createdProjectWorkspaces          ProjectWorkspaceGroup[]           @relation("ProjectWorkspaceCreator")
  clientProjectWorkspaces           ProjectWorkspaceGroup[]           @relation("ProjectWorkspaceClient")
  projectChangeRequests             ProjectChangeRequest[]            @relation("ProjectChangeRequester")
  reviewedProjectChangeRequests     ProjectChangeRequest[]            @relation("ProjectChangeReviewer")
  projectDeliverableReviews         ProjectDeliverableClientReview[]  @relation("ProjectDeliverableReviewClient")
  workflowEvents                    WorkflowEvent[]
  workflowFiles                     WorkflowFile[]
  workflowApprovals                 WorkflowApproval[]
  workflowNotifications             WorkflowNotification[]
  quotationApprovalAssignments      RequestWorkflow[]                 @relation("WorkflowQuotationApprover")
  paymentVerificationAssignments    RequestWorkflow[]                 @relation("WorkflowPaymentVerifier")
  createdPayrollCompensations       EmployeeCompensation[]            @relation("CompensationCreator")
  createdPayrollConfigurations      PayrollConfiguration[]            @relation("PayrollConfigurationCreator")
  createdPayrollPeriods             PayrollPeriod[]                   @relation("PayrollPeriodCreator")
  createdPayrollRuns                PayrollRun[]                      @relation("PayrollRunCreator")
  payrollCalculations               PayrollRunCalculation[]           @relation("PayrollCalculationCreator")

  @@index([departmentId])
  @@index([teamId])
  @@index([accountDeletedAt])
}

model Department {
  id                      String                @id @default(cuid())
  name                    String                @unique
  color                   String                @default("blue") @db.VarChar(16)
  code                    String?               @unique
  description             String?
  headId                  String?               @unique
  head                    User?                 @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  temporaryHeadOriginalId String?               @unique
  temporaryHeadOriginal   User?                 @relation("DepartmentTemporaryOriginalHead", fields: [temporaryHeadOriginalId], references: [id], onDelete: SetNull)
  temporaryHeadAssignedId String?               @unique
  temporaryHeadAssigned   User?                 @relation("DepartmentTemporaryAssignedHead", fields: [temporaryHeadAssignedId], references: [id], onDelete: SetNull)
  members                 User[]                @relation("DepartmentMembers")
  employees               Employee[]
  teams                   Team[]
  services                Service[]             @relation("ServiceDepartments")
  acceptedServiceRequests ServiceRequest[]      @relation("RequestAcceptedDepartment")
  requestConversations    RequestConversation[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([headId])
}

model Service {
  inquiries ServiceInquiry[]
  id                        String           @id @default(cuid())
  name                      String           @unique
  description               String
  iconKey                   String           @default("sparkles") @db.VarChar(32)
  imagePath                 String?
  imageAltText              String?
  clientRequirements        String[]         @default([])
  requiresConsultation      Boolean          @default(false)
  requiresAgreement         Boolean          @default(true)
  requiresPayment           Boolean          @default(true)
  requiresQuotationApproval Boolean          @default(false)
  consultationNotes         String?
  isActive                  Boolean          @default(true)
  pricingTemplateId         String?
  pricingTemplate           PricingTemplate? @relation(fields: [pricingTemplateId], references: [id], onDelete: SetNull)
  departments               Department[]     @relation("ServiceDepartments")
  keyBenefits               ServiceBenefit[]
  packages                  ServicePackage[]
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  serviceRequests           ServiceRequest[]

  @@index([isActive])
  @@index([pricingTemplateId])
}

model ServiceBenefit {
  id           String  @id @default(cuid())
  serviceId    String
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title        String
  description  String
  displayOrder Int     @default(0)

  @@index([serviceId, displayOrder])
}

model PricingTemplate {
  id              String           @id @default(cuid())
  name            String           @unique
  pricingModel    PricingModel
  currency        String           @default("PHP")
  amount          Decimal?         @db.Decimal(12, 2)
  billingInterval BillingInterval?
  isPublic        Boolean          @default(true)
  services        Service[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([pricingModel])
}

model ServicePackage {
  id               String           @id @default(cuid())
  serviceId        String
  service          Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name             String
  description      String
  includedFeatures String[]         @default([])
  pricingModel     PricingModel
  currency         String           @default("PHP")
  amount           Decimal?         @db.Decimal(12, 2)
  billingInterval  BillingInterval?
  isPricingPublic  Boolean          @default(true)
  isActive         Boolean          @default(true)
  displayOrder     Int              @default(0)
  isRecommended    Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  serviceRequests  ServiceRequest[]

  @@unique([serviceId, name])
  @@index([serviceId, isActive, displayOrder])
}

model ServiceRequest {
  id                      String                       @id @default(cuid())
  referenceNumber         String?                      @unique
  clientId                String
  client                  User                         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId               String
  service                 Service                      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  packageId               String?
  package                 ServicePackage?              @relation(fields: [packageId], references: [id], onDelete: SetNull)
  preferredSpecialistId   String?
  preferredSpecialist     Employee?                    @relation(fields: [preferredSpecialistId], references: [id], onDelete: SetNull)
  preferredSpecialistName String?
  title                   String
  description             String?
  requirementsPayload     Json?
  projectGoals            String                       @default("")
  projectRequirements     String                       @default("")
  expectedTimeline        String                       @default("") @db.VarChar(300)
  additionalDetails       String?
  status                  ServiceRequestStatus         @default(SUBMITTED)
  acceptedDepartmentId    String?
  acceptedDepartment      Department?                  @relation("RequestAcceptedDepartment", fields: [acceptedDepartmentId], references: [id], onDelete: Restrict)
  acceptedById            String?
  acceptedBy              User?                        @relation("RequestAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  acceptedAt              DateTime?
  clientReadAt            DateTime?
  staffReadAt             DateTime?
  conversationId          String?
  conversation            RequestConversation?         @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messages                ServiceRequestMessage[]
  meetings                ConversationMeetingBooking[]
  workflow                RequestWorkflow?
  project                 Project?
  pricingModel            PricingModel?
  agreedPrice             Decimal?                     @db.Decimal(12, 2)
  quotedPrice             Decimal?                     @db.Decimal(12, 2)
  currency                String?
  billingInterval         BillingInterval?
  packageName             String?
  submissionKey           String?                      @db.VarChar(36)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  @@unique([clientId, submissionKey])
  @@index([clientId, createdAt, id])
  @@index([serviceId])
  @@index([packageId])
  @@index([preferredSpecialistId])
  @@index([referenceNumber])
  @@index([acceptedDepartmentId, createdAt])
  @@index([conversationId, createdAt, id])
}

model RequestConversation {
  id            String                        @id @default(cuid())
  clientId      String
  client        User                          @relation("RequestConversationClient", fields: [clientId], references: [id], onDelete: Restrict)
  departmentId  String
  department    Department                    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  clientReadAt  DateTime?
  managerReadAt DateTime?
  bookings      ServiceRequest[]
  messages      ServiceRequestMessage[]
  meetings      ConversationMeeting[]
  deletions     RequestConversationDeletion[]
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  @@unique([clientId, departmentId])
  @@index([departmentId, updatedAt, id])
  @@index([clientId, updatedAt, id])
}

model ConversationMeeting {
  id               String                       @id @default(cuid())
  conversationId   String
  conversation     RequestConversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clientActionId   String                       @db.VarChar(36)
  startsAt         DateTime
  endsAt           DateTime
  location         String                       @db.VarChar(1000)
  notes            String                       @db.VarChar(2000)
  status           WorkflowConsultationStatus   @default(SCHEDULED)
  version          Int                          @default(0)
  proposedStartsAt DateTime?
  rescheduleNote   String?                      @db.VarChar(2000)
  bookings         ConversationMeetingBooking[]
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([conversationId, clientActionId])
  @@index([conversationId, createdAt, id])
}

model ConversationMeetingBooking {
  meetingId String
  meeting   ConversationMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  bookingId String
  booking   ServiceRequest      @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@id([meetingId, bookingId])
  @@index([bookingId])
}

model RequestConversationDeletion {
  conversationId String
  conversation   RequestConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt      DateTime            @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model ServiceRequestMessage {
  id              String              @id @default(cuid())
  conversationId  String
  conversation    RequestConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId       String?
  request         ServiceRequest?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  senderId        String
  sender          User                @relation(fields: [senderId], references: [id], onDelete: Restrict)
  clientMessageId String              @db.VarChar(36)
  body            String?             @db.VarChar(4000)
  createdAt       DateTime            @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?
  purgeAt         DateTime?

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([conversationId, senderId, createdAt])
  @@index([requestId, createdAt, id])
  @@index([purgeAt])
}

model InternalConversation {
  id               String                            @id @default(cuid())
  participantKey   String                            @unique
  participantOneId String
  participantOne   User                              @relation("InternalConversationFirstParticipant", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwoId String
  participantTwo   User                              @relation("InternalConversationSecondParticipant", fields: [participantTwoId], references: [id], onDelete: Cascade)
  participants     InternalConversationParticipant[]
  messages         InternalMessage[]
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt

  @@index([participantOneId])
  @@index([participantTwoId])
  @@index([updatedAt, id])
}

model InternalConversationParticipant {
  conversationId String
  conversation   InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?

  @@id([conversationId, userId])
  @@index([userId])
}

model InternalMessage {
  id              String               @id @default(cuid())
  conversationId  String
  conversation    InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User                 @relation("InternalMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  clientMessageId String               @db.VarChar(36)
  body            String               @db.VarChar(4000)
  createdAt       DateTime             @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?
  purgeAt         DateTime?

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([conversationId, senderId, createdAt])
  @@index([purgeAt])
}

model Project {
  id                String                    @id @default(cuid())
  clientId          String
  client            User                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name              String
  description       String?
  status            ProjectStatus             @default(PLANNED)
  startDate         DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  requestId         String?                   @unique
  request           ServiceRequest?           @relation(fields: [requestId], references: [id], onDelete: Restrict)
  quotationId       String?                   @unique
  quotation         WorkflowQuotation?        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  templateKey       String?                   @db.VarChar(60)
  workPlan          Json?
  workspaceGroupId  String?
  workspaceGroup    ProjectWorkspaceGroup?    @relation(fields: [workspaceGroupId], references: [id], onDelete: SetNull)
  staff             ProjectStaff[]
  milestones        ProjectMilestone[]
  changeRequests    ProjectChangeRequest[]
  messages          ProjectMessage[]
  conversationReads ProjectConversationRead[]

  @@index([clientId, createdAt, id])
  @@index([workspaceGroupId])
}

model ProjectMessage {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  clientMessageId String   @db.VarChar(36)
  body            String   @db.VarChar(4000)
  clientVisible   Boolean  @default(true)
  deliverable     Json?
  createdAt       DateTime @default(now())

  @@unique([projectId, senderId, clientMessageId])
  @@index([projectId, createdAt, id])
}

model ProjectConversationRead {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime

  @@id([projectId, userId])
  @@index([userId])
}

model ProjectWorkspaceGroup {
  id          String                    @id @default(cuid())
  name        String                    @db.VarChar(200)
  structure   ProjectWorkspaceStructure
  clientId    String
  client      User                      @relation("ProjectWorkspaceClient", fields: [clientId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User                      @relation("ProjectWorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
