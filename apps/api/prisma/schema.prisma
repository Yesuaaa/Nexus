  ESCALATED
  APPROVED
  REVISION_REQUIRED
  REJECTED
}

enum ProjectClientReviewStatus {
  APPROVED
  REVISION_REQUESTED
}

enum ProjectChangeRequestStatus {
  PENDING
  ACCEPTED
  NOT_APPROVED
}

enum ProjectChangeRequestKind {
  CHANGE
  CANCELLATION
}

enum ProjectWorkspaceStructure {
  SEPARATE
  MULTI_WORKSTREAM
}

enum RequestWorkflowState {
  PENDING_REVIEW
  CONSULTATION
  QUOTATION_PENDING
  CLIENT_APPROVAL
  AGREEMENT_PAYMENT_PENDING
  READY_FOR_ACTIVATION
  ACTIVE_PROJECT
  DECLINED
  CANCELLED
  REVISION_REQUESTED
  ON_HOLD
}

enum WorkflowRequirementStatus {
  REQUESTED
  SUBMITTED
  COMPLETED
}

enum WorkflowQuotationStatus {
  PENDING_INTERNAL
  SENT
  ACCEPTED
  DECLINED
  REVISION_REQUESTED
  SUPERSEDED
}

enum WorkflowDocumentStatus {
  PENDING
  SUBMITTED
  APPROVED
}

enum WorkflowPaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
}

enum WorkflowConsultationStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  attendanceRequests                AttendanceAdjustment[]            @relation("AttendanceRequester")
  attendanceReviews                 AttendanceAdjustment[]            @relation("AttendanceReviewer")
  attendanceVerifications           AttendanceAdjustment[]            @relation("AttendanceVerifier")
  attendanceAudit                   AttendanceAudit[]
  leaveRequests                     LeaveRequest[]                     @relation("LeaveRequester")
  leaveDecisions                    LeaveDecision[]
  leaveVerifications                LeaveRequest[]                     @relation("LeaveVerifier")
  id                                String                            @id @default(cuid())
  email                             String                            @unique
  fullName                          String?
  contactNumber                     String?
  profileImagePath                  String?
  profileBannerPath                 String?
  position                          String?
  settings                          Json                              @default("{}")
  passwordHash                      String
  role                              Role                              @default(USER)
  isActive                          Boolean                           @default(true)
  accountDeletedAt                  DateTime?
  createdAt                         DateTime                          @default(now())
  updatedAt                         DateTime                          @updatedAt
  departmentId                      String?
  department                        Department?                       @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  headOf                            Department?                       @relation("DepartmentHead")
  teamId                            String?
  team                              Team?                             @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  leadOfTeam                        Team?                             @relation("TeamLead")
  employee                          Employee?
  temporaryOriginalDepartmentHeadOf Department?                       @relation("DepartmentTemporaryOriginalHead")
  temporaryAssignedDepartmentHeadOf Department?                       @relation("DepartmentTemporaryAssignedHead")
  sessions                          Session[]
  serviceRequests                   ServiceRequest[]
  acceptedServiceRequests           ServiceRequest[]                  @relation("RequestAcceptedBy")
  requestMessages                   ServiceRequestMessage[]
  requestConversations              RequestConversation[]             @relation("RequestConversationClient")
  conversationDeletions             RequestConversationDeletion[]
  internalConversationsAsFirst      InternalConversation[]            @relation("InternalConversationFirstParticipant")
  internalConversationsAsSecond     InternalConversation[]            @relation("InternalConversationSecondParticipant")
  internalConversationParticipants  InternalConversationParticipant[]
  internalMessages                  InternalMessage[]                 @relation("InternalMessageSender")
  projectMessages                   ProjectMessage[]
  projectConversationReads          ProjectConversationRead[]
  projects                          Project[]
  authoredProjectNotes              ProjectNote[]                     @relation("ProjectNoteAuthor")
  authoredProjectNoteRevisions      ProjectNoteRevision[]             @relation("ProjectNoteRevisionAuthor")
  reviewedProjectNoteRevisions      ProjectNoteRevision[]             @relation("ProjectNoteRevisionReviewer")
  publishedProjectNoteRevisions     ProjectNoteRevision[]             @relation("ProjectNoteRevisionPublisher")
  unpublishedProjectNoteRevisions   ProjectNoteRevision[]             @relation("ProjectNoteRevisionUnpublisher")
  submittedProjectDeliverables      ProjectDeliverableSubmission[]    @relation("ProjectDeliverableSubmissionAuthor")
  reviewedProjectDeliverableHistory ProjectDeliverableSubmission[]    @relation("ProjectDeliverableSubmissionReviewer")
  createdProjectWorkspaces          ProjectWorkspaceGroup[]           @relation("ProjectWorkspaceCreator")
  clientProjectWorkspaces           ProjectWorkspaceGroup[]           @relation("ProjectWorkspaceClient")
  projectChangeRequests             ProjectChangeRequest[]            @relation("ProjectChangeRequester")
  reviewedProjectChangeRequests     ProjectChangeRequest[]            @relation("ProjectChangeReviewer")
  projectDeliverableReviews         ProjectDeliverableClientReview[]  @relation("ProjectDeliverableReviewClient")
  workflowEvents                    WorkflowEvent[]
  workflowFiles                     WorkflowFile[]
  workflowApprovals                 WorkflowApproval[]
  workflowNotifications             WorkflowNotification[]
  quotationApprovalAssignments      RequestWorkflow[]                 @relation("WorkflowQuotationApprover")
  paymentVerificationAssignments    RequestWorkflow[]                 @relation("WorkflowPaymentVerifier")

  @@index([departmentId])
  @@index([teamId])
  @@index([accountDeletedAt])
}

model Department {
  id                      String                @id @default(cuid())
  name                    String                @unique
  color                   String                @default("blue") @db.VarChar(16)
  code                    String?               @unique
  description             String?
  headId                  String?               @unique
  head                    User?                 @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  temporaryHeadOriginalId String?               @unique
  temporaryHeadOriginal   User?                 @relation("DepartmentTemporaryOriginalHead", fields: [temporaryHeadOriginalId], references: [id], onDelete: SetNull)
  temporaryHeadAssignedId String?               @unique
  temporaryHeadAssigned   User?                 @relation("DepartmentTemporaryAssignedHead", fields: [temporaryHeadAssignedId], references: [id], onDelete: SetNull)
  members                 User[]                @relation("DepartmentMembers")
  employees               Employee[]
  teams                   Team[]
  services                Service[]             @relation("ServiceDepartments")
  acceptedServiceRequests ServiceRequest[]      @relation("RequestAcceptedDepartment")
  requestConversations    RequestConversation[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([headId])
}

model Service {
  id                        String           @id @default(cuid())
  name                      String           @unique
  description               String
  iconKey                   String           @default("sparkles") @db.VarChar(32)
  imagePath                 String?
  imageAltText              String?
  clientRequirements        String[]         @default([])
  requiresConsultation      Boolean          @default(false)
  requiresAgreement         Boolean          @default(true)
  requiresPayment           Boolean          @default(true)
  requiresQuotationApproval Boolean          @default(false)
  consultationNotes         String?
  isActive                  Boolean          @default(true)
  pricingTemplateId         String?
  pricingTemplate           PricingTemplate? @relation(fields: [pricingTemplateId], references: [id], onDelete: SetNull)
  departments               Department[]     @relation("ServiceDepartments")
  keyBenefits               ServiceBenefit[]
  packages                  ServicePackage[]
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  serviceRequests           ServiceRequest[]

  @@index([isActive])
  @@index([pricingTemplateId])
}

model ServiceBenefit {
  id           String  @id @default(cuid())
  serviceId    String
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title        String
  description  String
  displayOrder Int     @default(0)

  @@index([serviceId, displayOrder])
}

model PricingTemplate {
  id              String           @id @default(cuid())
  name            String           @unique
  pricingModel    PricingModel
  currency        String           @default("PHP")
  amount          Decimal?         @db.Decimal(12, 2)
  billingInterval BillingInterval?
  isPublic        Boolean          @default(true)
  services        Service[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([pricingModel])
}

model ServicePackage {
  id               String           @id @default(cuid())
  serviceId        String
  service          Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name             String
  description      String
  includedFeatures String[]         @default([])
  pricingModel     PricingModel
  currency         String           @default("PHP")
  amount           Decimal?         @db.Decimal(12, 2)
  billingInterval  BillingInterval?
  isPricingPublic  Boolean          @default(true)
  isActive         Boolean          @default(true)
  displayOrder     Int              @default(0)
  isRecommended    Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  serviceRequests  ServiceRequest[]

  @@unique([serviceId, name])
  @@index([serviceId, isActive, displayOrder])
}

model ServiceRequest {
  id                      String                       @id @default(cuid())
  referenceNumber         String?                      @unique
  clientId                String
  client                  User                         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId               String
  service                 Service                      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  packageId               String?
  package                 ServicePackage?              @relation(fields: [packageId], references: [id], onDelete: SetNull)
  preferredSpecialistId   String?
  preferredSpecialist     Employee?                    @relation(fields: [preferredSpecialistId], references: [id], onDelete: SetNull)
  preferredSpecialistName String?
  title                   String
  description             String?
  requirementsPayload     Json?
  projectGoals            String                       @default("")
  projectRequirements     String                       @default("")
  expectedTimeline        String                       @default("") @db.VarChar(300)
  additionalDetails       String?
  status                  ServiceRequestStatus         @default(SUBMITTED)
  acceptedDepartmentId    String?
  acceptedDepartment      Department?                  @relation("RequestAcceptedDepartment", fields: [acceptedDepartmentId], references: [id], onDelete: Restrict)
  acceptedById            String?
  acceptedBy              User?                        @relation("RequestAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  acceptedAt              DateTime?
  clientReadAt            DateTime?
  staffReadAt             DateTime?
  conversationId          String?
  conversation            RequestConversation?         @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messages                ServiceRequestMessage[]
  meetings                ConversationMeetingBooking[]
  workflow                RequestWorkflow?
  project                 Project?
  pricingModel            PricingModel?
  agreedPrice             Decimal?                     @db.Decimal(12, 2)
  quotedPrice             Decimal?                     @db.Decimal(12, 2)
  currency                String?
  billingInterval         BillingInterval?
  packageName             String?
  submissionKey           String?                      @db.VarChar(36)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  @@unique([clientId, submissionKey])
  @@index([clientId, createdAt, id])
  @@index([serviceId])
  @@index([packageId])
  @@index([preferredSpecialistId])
  @@index([referenceNumber])
  @@index([acceptedDepartmentId, createdAt])
  @@index([conversationId, createdAt, id])
}

model RequestConversation {
  id            String                        @id @default(cuid())
  clientId      String
  client        User                          @relation("RequestConversationClient", fields: [clientId], references: [id], onDelete: Restrict)
  departmentId  String
  department    Department                    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  clientReadAt  DateTime?
  managerReadAt DateTime?
  bookings      ServiceRequest[]
  messages      ServiceRequestMessage[]
  meetings      ConversationMeeting[]
  deletions     RequestConversationDeletion[]
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  @@unique([clientId, departmentId])
  @@index([departmentId, updatedAt, id])
  @@index([clientId, updatedAt, id])
}

model ConversationMeeting {
  id               String                       @id @default(cuid())
  conversationId   String
  conversation     RequestConversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clientActionId   String                       @db.VarChar(36)
  startsAt         DateTime
  endsAt           DateTime
  location         String                       @db.VarChar(1000)
  notes            String                       @db.VarChar(2000)
  status           WorkflowConsultationStatus   @default(SCHEDULED)
  version          Int                          @default(0)
  proposedStartsAt DateTime?
  rescheduleNote   String?                      @db.VarChar(2000)
  bookings         ConversationMeetingBooking[]
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([conversationId, clientActionId])
  @@index([conversationId, createdAt, id])
}

model ConversationMeetingBooking {
  meetingId String
  meeting   ConversationMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  bookingId String
  booking   ServiceRequest      @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@id([meetingId, bookingId])
  @@index([bookingId])
}

model RequestConversationDeletion {
  conversationId String
  conversation   RequestConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt      DateTime            @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model ServiceRequestMessage {
  id              String              @id @default(cuid())
  conversationId  String
  conversation    RequestConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId       String?
  request         ServiceRequest?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  senderId        String
  sender          User                @relation(fields: [senderId], references: [id], onDelete: Restrict)
  clientMessageId String              @db.VarChar(36)
  body            String?             @db.VarChar(4000)
  createdAt       DateTime            @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?
  purgeAt         DateTime?

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([conversationId, senderId, createdAt])
  @@index([requestId, createdAt, id])
  @@index([purgeAt])
}

model InternalConversation {
  id               String                            @id @default(cuid())
  participantKey   String                            @unique
  participantOneId String
  participantOne   User                              @relation("InternalConversationFirstParticipant", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwoId String
  participantTwo   User                              @relation("InternalConversationSecondParticipant", fields: [participantTwoId], references: [id], onDelete: Cascade)
  participants     InternalConversationParticipant[]
  messages         InternalMessage[]
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt

  @@index([participantOneId])
  @@index([participantTwoId])
  @@index([updatedAt, id])
}

model InternalConversationParticipant {
  conversationId String
  conversation   InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?

  @@id([conversationId, userId])
  @@index([userId])
}

model InternalMessage {
  id              String               @id @default(cuid())
  conversationId  String
  conversation    InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User                 @relation("InternalMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  clientMessageId String               @db.VarChar(36)
  body            String               @db.VarChar(4000)
  createdAt       DateTime             @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?
  purgeAt         DateTime?

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([conversationId, senderId, createdAt])
  @@index([purgeAt])
}

model Project {
  id                String                    @id @default(cuid())
  clientId          String
  client            User                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name              String
  description       String?
  status            ProjectStatus             @default(PLANNED)
  startDate         DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  requestId         String?                   @unique
  request           ServiceRequest?           @relation(fields: [requestId], references: [id], onDelete: Restrict)
  quotationId       String?                   @unique
  quotation         WorkflowQuotation?        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  templateKey       String?                   @db.VarChar(60)
  workPlan          Json?
  workspaceGroupId  String?
  workspaceGroup    ProjectWorkspaceGroup?    @relation(fields: [workspaceGroupId], references: [id], onDelete: SetNull)
  staff             ProjectStaff[]
  milestones        ProjectMilestone[]
  changeRequests    ProjectChangeRequest[]
  notes             ProjectNote[]
  messages          ProjectMessage[]
  conversationReads ProjectConversationRead[]

  @@index([clientId, createdAt, id])
  @@index([workspaceGroupId])
}

model ProjectMessage {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  clientMessageId String   @db.VarChar(36)
  body            String   @db.VarChar(4000)
  clientVisible   Boolean  @default(true)
  deliverable     Json?
  createdAt       DateTime @default(now())

  @@unique([projectId, senderId, clientMessageId])
  @@index([projectId, createdAt, id])
}

model ProjectConversationRead {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime

  @@id([projectId, userId])
  @@index([userId])
}

model ProjectWorkspaceGroup {
  id          String                    @id @default(cuid())
  name        String                    @db.VarChar(200)
  structure   ProjectWorkspaceStructure
  clientId    String
  client      User                      @relation("ProjectWorkspaceClient", fields: [clientId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User                      @relation("ProjectWorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  projects    Project[]

  @@index([clientId, createdAt, id])
}

model Team {
  id           String     @id @default(cuid())
  name         String
  description  String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  leadId       String?    @unique
  lead         User?      @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members      User[]     @relation("TeamMembers")
  employees    Employee[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([leadId])
}

model Employee {
  attendanceAdjustments    AttendanceAdjustment[]
  attendanceAudit          AttendanceAudit[]
  attendanceAssignments    AttendancePolicyAssignment[]
  attendanceWorkdays       AttendanceWorkday[]
  leaveRequests            LeaveRequest[]
  leaveRequestDays         LeaveRequestDay[]
  id                       String                       @id @default(cuid())
  employeeId               String                       @unique
  fullName                 String
  email                    String?
  contactNumber            String?
  position                 String?
  employmentType           EmploymentType               @default(FULL_TIME)
  status                   EmployeeStatus               @default(ACTIVE)
  startDate                DateTime?
  departmentId             String?
  department               Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId                   String?
  team                     Team?                        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  userId                   String?                      @unique
  user                     User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  preferredServiceRequests ServiceRequest[]
  profileBio               String?                      @db.VarChar(2000)
  profileImageUrl          String?                      @db.VarChar(2048)
  profileBannerUrl         String?                      @db.VarChar(2048)
  profileSpecialties       String[]                     @default([])
  portfolioProjects        SpecialistPortfolioProject[]
  socialLinks              SpecialistSocialLink[]
  projectAssignments       ProjectStaff[]
  workloadCapacities       WorkloadCapacity[]

  @@index([departmentId])
  @@index([teamId])
  @@index([status])
  @@index([employmentType])
  @@index([fullName])
}

// Workflow records, rather than chat messages, authorize business decisions.
model RequestWorkflow {
  requestId                 String                  @id
  request                   ServiceRequest          @relation(fields: [requestId], references: [id], onDelete: Restrict)
  state                     RequestWorkflowState    @default(CONSULTATION)
  previousState             RequestWorkflowState?
  version                   Int                     @default(1)
  consultationRequired      Boolean                 @default(false)
  agreementRequired         Boolean                 @default(true)
  paymentRequired           Boolean                 @default(true)
  quotationApprovalRequired Boolean                 @default(false)
  quotationApproverId       String?
  quotationApprover         User?                   @relation("WorkflowQuotationApprover", fields: [quotationApproverId], references: [id], onDelete: Restrict)
  paymentVerifierId         String?
  paymentVerifier           User?                   @relation("WorkflowPaymentVerifier", fields: [paymentVerifierId], references: [id], onDelete: Restrict)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  requirements              WorkflowRequirement[]
  files                     WorkflowFile[]
  consultations             WorkflowConsultation[]
  quotations                WorkflowQuotation[]
  approval                  WorkflowApproval?
  agreement                 WorkflowAgreement?
  payment                   WorkflowPayment?
  events                    WorkflowEvent[]
  actions                   WorkflowActionReceipt[]
  notifications             WorkflowNotification[]
}

model WorkflowRequirement {
  id          String                    @id @default(cuid())
  requestId   String
  workflow    RequestWorkflow           @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  title       String                    @db.VarChar(300)
  details     String?                   @db.VarChar(4000)
  mandatory   Boolean                   @default(true)
  status      WorkflowRequirementStatus @default(REQUESTED)
  submission  String?                   @db.VarChar(4000)
  fileId      String?
  file        WorkflowFile?             @relation(fields: [fileId], references: [id], onDelete: Restrict)
  attachments WorkflowFile[]            @relation("RequirementAttachments")
  reviewNote  String?                   @db.VarChar(2000)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([requestId, createdAt])
}

model WorkflowFile {
  id                       String                           @id @default(cuid())
  requestId                String
  workflow                 RequestWorkflow                  @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  uploaderId               String
  uploader                 User                             @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  uploadId                 String                           @db.VarChar(36)
  name                     String                           @db.VarChar(160)
  mimeType                 String                           @db.VarChar(100)
  size                     Int
  sha256                   String                           @db.VarChar(64)
  clientVisible            Boolean                          @default(true)
  data                     Bytes
  createdAt                DateTime                         @default(now())
  requirements             WorkflowRequirement[]
  requirementAttachments   WorkflowRequirement[]            @relation("RequirementAttachments")
  agreements               WorkflowAgreement[]              @relation("AgreementDocument")
  signatures               WorkflowAgreement[]              @relation("AgreementSignature")
  payments                 WorkflowPayment[]
  deliverableMilestone     ProjectMilestone?
  deliverableSubmission    ProjectDeliverableSubmission?
  clientDeliverableReviews ProjectDeliverableClientReview[]

  @@unique([requestId, uploaderId, uploadId])
  @@index([requestId, createdAt])
}

model WorkflowConsultation {
  id        String                     @id @default(cuid())
  requestId String
  workflow  RequestWorkflow            @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  startsAt  DateTime
  endsAt    DateTime
  location  String                     @db.VarChar(1000)
  notes     String?                    @db.VarChar(2000)
  status    WorkflowConsultationStatus @default(SCHEDULED)
  createdAt DateTime                   @default(now())

  @@index([requestId, startsAt])
}

model WorkflowQuotation {
  id                     String                  @id @default(cuid())
  requestId              String
  workflow               RequestWorkflow         @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  version                Int
  status                 WorkflowQuotationStatus @default(SENT)
  scope                  String                  @db.VarChar(6000)
  deliverables           String[]
  lineItems              Json
  total                  Decimal                 @db.Decimal(12, 2)
  currency               String                  @db.VarChar(3)
  timeline               String                  @db.VarChar(1000)
  paymentTerms           String                  @db.VarChar(2000)
  paymentDue             Decimal                 @db.Decimal(12, 2)
  validUntil             DateTime
  decisionNote           String?                 @db.VarChar(2000)
  createdById            String
  internallyApprovedById String?
  internallyApprovedAt   DateTime?
  publishedAt            DateTime?
  createdAt              DateTime                @default(now())
  approval               WorkflowApproval?
  project                Project?

  @@unique([requestId, version])
}

model WorkflowApproval {
  id           String            @id @default(cuid())
  requestId    String            @unique
  workflow     RequestWorkflow   @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  quotationId  String            @unique
  quotation    WorkflowQuotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  amount       Decimal           @db.Decimal(12, 2)
  currency     String            @db.VarChar(3)
  approvedById String
  approvedBy   User              @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt   DateTime          @default(now())
}

model WorkflowAgreement {
  id             String                 @id @default(cuid())
  requestId      String                 @unique
  workflow       RequestWorkflow        @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  mandatory      Boolean                @default(true)
  status         WorkflowDocumentStatus @default(PENDING)
  documentFileId String?
  documentFile   WorkflowFile?          @relation("AgreementDocument", fields: [documentFileId], references: [id], onDelete: Restrict)
  signedFileId   String?
  signedFile     WorkflowFile?          @relation("AgreementSignature", fields: [signedFileId], references: [id], onDelete: Restrict)
  reviewedById   String?
  reviewedAt     DateTime?
}

model WorkflowPayment {
  id           String                @id @default(cuid())
  requestId    String                @unique
  workflow     RequestWorkflow       @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  mandatory    Boolean               @default(true)
  amount       Decimal               @db.Decimal(12, 2)
  currency     String                @db.VarChar(3)
  status       WorkflowPaymentStatus @default(PENDING)
  proofFileId  String?
  proofFile    WorkflowFile?         @relation(fields: [proofFileId], references: [id], onDelete: Restrict)
  reference    String?               @db.VarChar(300)
  verifiedById String?
  verifiedAt   DateTime?
}

model WorkflowEvent {
  id            String                 @id @default(cuid())
  requestId     String
  workflow      RequestWorkflow        @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  actorId       String?
  actor         User?                  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  type          String                 @db.VarChar(60)
  summary       String                 @db.VarChar(4000)
  entityId      String?
  internal      Boolean                @default(false)
  createdAt     DateTime               @default(now())
  notifications WorkflowNotification[]

  @@index([requestId, createdAt, id])
}

model WorkflowActionReceipt {
  id          String          @id @default(cuid())
  requestId   String
  workflow    RequestWorkflow @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  actorId     String
  actionId    String          @db.VarChar(36)
  payloadHash String          @db.VarChar(64)
  createdAt   DateTime        @default(now())

  @@unique([requestId, actorId, actionId])
}

model WorkflowNotification {
  id                     String                @id @default(cuid())
  userId                 String
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  requestId              String?
  workflow               RequestWorkflow?      @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  eventId                String?
  event                  WorkflowEvent?        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  attendanceAdjustmentId String?
  attendanceAdjustment   AttendanceAdjustment? @relation(fields: [attendanceAdjustmentId], references: [id], onDelete: Restrict)
  leaveRequestId         String?
  leaveRequest           LeaveRequest?         @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)
  type                   String?
  summary                String?
  readAt                 DateTime?
  createdAt              DateTime              @default(now())

  @@unique([userId, eventId])
  @@unique([userId, attendanceAdjustmentId, type])
  @@unique([userId, leaveRequestId, type])
  @@index([userId, readAt, createdAt])
}

model LeaveRequest {
  id                String        @id @default(cuid())
  requestKey        String        @db.Uuid
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  requestedById     String
  requestedBy       User          @relation("LeaveRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  routeDepartmentId String?
  verifiedById      String?
  verifiedBy        User?         @relation("LeaveVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  verifiedAt        DateTime?     @db.Timestamptz(3)
  type              LeaveType
  reason            String        @db.VarChar(2000)
  startDate         DateTime      @db.Date
  endDate           DateTime      @db.Date
  status            LeaveStatus   @default(SUBMITTED)
  version           Int           @default(1)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  days              LeaveRequestDay[]
  decisions         LeaveDecision[]
  notifications     WorkflowNotification[]

  @@unique([requestedById, requestKey])
  @@index([employeeId, startDate, endDate])
  @@index([status, createdAt, id])
  @@index([routeDepartmentId, status, createdAt])
}

model LeaveRequestDay {
  id                  String                     @id @default(cuid())
  requestId           String
  request             LeaveRequest               @relation(fields: [requestId], references: [id], onDelete: Restrict)
  employeeId          String
  employee            Employee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignmentId        String
  assignment          AttendancePolicyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  workDate            DateTime                   @db.Date
  timeZone            String                     @db.VarChar(100)
  policyName          String                     @db.VarChar(100)
  baseRequiredMinutes Int
  leaveMinutes        Int
  createdAt           DateTime                   @default(now()) @db.Timestamptz(3)

  @@unique([requestId, workDate])
  @@index([employeeId, workDate])
}

model LeaveDecision {
  id         String       @id @default(cuid())
  requestId  String
  request    LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actorId    String
  actor      User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actionId   String       @db.Uuid
  action     LeaveAction
  fromStatus LeaveStatus?
  toStatus   LeaveStatus
  note       String?      @db.VarChar(2000)
  version    Int
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([requestId, actorId, actionId])
  @@index([requestId, createdAt, id])
}

model WorkloadCapacity {
  id             String   @id @default(cuid())
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId     String
  week           String   @db.VarChar(10)
  scheduledHours Float
  timeOffHours   Float    @default(0)
  updatedById    String

  @@unique([employeeId, week])
}

model ProjectStaff {
  isTeamLead      Boolean   @default(false)
  weeklyHours     Float?
  allocationStart DateTime?
  allocationEnd   DateTime?
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  approvedById    String
  approvedAt      DateTime  @default(now())

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

model ProjectMilestone {
  id               String                           @id @default(cuid())
  projectId        String
  project          Project                          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  title            String                           @db.VarChar(300)
  description      String?                          @db.VarChar(4000)
  expectedFileType String?                          @db.VarChar(50)
  deliveryStatus   ProjectDeliverableStatus         @default(NOT_SUBMITTED)
  rejectionReason  String?                          @db.VarChar(2000)
  reviewedById     String?
  reviewedAt       DateTime?
  sentToClientById String?
  sentToClientAt   DateTime?
  workflowFileId   String?                          @unique
  workflowFile     WorkflowFile?                    @relation(fields: [workflowFileId], references: [id], onDelete: SetNull)
  completedAt      DateTime?
  displayOrder     Int                              @default(0)
  updatedAt        DateTime                         @default(now()) @updatedAt
  clientReviews    ProjectDeliverableClientReview[]
  submissions      ProjectDeliverableSubmission[]

  @@index([projectId, displayOrder])
}

model ProjectDeliverableSubmission {
  id             String                             @id @default(cuid())
  milestoneId    String
  milestone      ProjectMilestone                   @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  workflowFileId String                             @unique
  workflowFile   WorkflowFile                       @relation(fields: [workflowFileId], references: [id], onDelete: Restrict)
  submittedById  String
  submittedBy    User                               @relation("ProjectDeliverableSubmissionAuthor", fields: [submittedById], references: [id], onDelete: Restrict)
  version        Int
  note           String?                            @db.VarChar(2000)
  status         ProjectDeliverableSubmissionStatus
  submittedAt    DateTime                           @default(now())
  reviewedById   String?
  reviewedBy     User?                              @relation("ProjectDeliverableSubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  feedback       String?                            @db.VarChar(2000)
  escalatedAt    DateTime?
  updatedAt      DateTime                           @updatedAt

  @@unique([milestoneId, version])
  @@index([milestoneId, submittedAt, id])
  @@index([status, escalatedAt])
}

model ProjectNote {
  id          String                @id @default(cuid())
  projectId   String
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User                  @relation("ProjectNoteAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  revisions   ProjectNoteRevision[]

  @@index([projectId, updatedAt, id])
}

model ProjectNoteRevision {
  id                     String                    @id @default(cuid())
  noteId                 String
  note                   ProjectNote               @relation(fields: [noteId], references: [id], onDelete: Cascade)
  revision               Int
  content                String                    @db.VarChar(4000)
  authorId               String
  author                 User                      @relation("ProjectNoteRevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  status                 ProjectNoteRevisionStatus @default(SUBMITTED)
  submittedAt            DateTime                  @default(now())
  reviewedById           String?
  reviewedBy             User?                     @relation("ProjectNoteRevisionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt             DateTime?
  feedback               String?                   @db.VarChar(2000)
  escalatedAt            DateTime?
  clientVisible          Boolean                   @default(false)
  publishedAt            DateTime?
  publishedById          String?
  publishedBy            User?                     @relation("ProjectNoteRevisionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  supersededAt           DateTime?
  supersededByRevisionId String?
  supersededByRevision   ProjectNoteRevision?      @relation("ProjectNoteRevisionSupersession", fields: [supersededByRevisionId], references: [id], onDelete: SetNull)
  supersededRevisions    ProjectNoteRevision[]     @relation("ProjectNoteRevisionSupersession")
  unpublishedAt          DateTime?
  unpublishedById        String?
  unpublishedBy          User?                     @relation("ProjectNoteRevisionUnpublisher", fields: [unpublishedById], references: [id], onDelete: SetNull)
  createdAt              DateTime                  @default(now())

  @@unique([noteId, revision])
  @@index([noteId, createdAt, id])
  @@index([status, escalatedAt])
  @@index([clientVisible, status])
  @@index([publishedById])
  @@index([supersededByRevisionId])
  @@index([unpublishedById])
}

model ProjectDeliverableClientReview {
  id             String                    @id @default(cuid())
  milestoneId    String
  milestone      ProjectMilestone          @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  workflowFileId String?
  workflowFile   WorkflowFile?             @relation(fields: [workflowFileId], references: [id], onDelete: SetNull)
  clientId       String
  client         User                      @relation("ProjectDeliverableReviewClient", fields: [clientId], references: [id], onDelete: Restrict)
  status         ProjectClientReviewStatus
  note           String?                   @db.VarChar(2000)
  createdAt      DateTime                  @default(now())

  @@unique([workflowFileId, clientId])
  @@index([milestoneId, createdAt])
  @@index([workflowFileId])
}

model ProjectChangeRequest {
  id            String                     @id @default(cuid())
  projectId     String
  project       Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestedById String
  requestedBy   User                       @relation("ProjectChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  kind          ProjectChangeRequestKind   @default(CHANGE)
  details       String                     @db.VarChar(4000)
  status        ProjectChangeRequestStatus @default(PENDING)
  responseNote  String?                    @db.VarChar(2000)
  reviewedById  String?
  reviewedBy    User?                      @relation("ProjectChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([projectId, status, createdAt])
  @@index([projectId, kind, status, createdAt], map: "project_change_request_pending_lookup_idx")
}

model SpecialistPortfolioProject {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title        String   @db.VarChar(160)
  summary      String   @db.VarChar(3000)
  contribution String?  @db.VarChar(2000)
  thumbnailUrl String?  @db.VarChar(2048)
  projectUrl   String?  @db.VarChar(2048)
  isPublished  Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId, isPublished, displayOrder], map: "specialist_portfolio_published_order_idx")
}

model SpecialistSocialLink {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  platform     String   @db.VarChar(40)
  url          String   @db.VarChar(2048)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId, displayOrder], map: "specialist_social_link_order_idx")
}

model Session {
  approximateLocation String?
  userAgent           String?
  lastActiveAt        DateTime?
  id                  String         @id @default(cuid())
  tokenHash           String         @unique
  userId              String
  expiresAt           DateTime
  createdAt           DateTime       @default(now())
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens       RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  sessionId  String
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AttendancePolicy {
  archivedAt              DateTime?                    @db.Timestamptz(3)
  unpaidBreaksEnabled     Boolean                      @default(true)
  overnightRequiresReview Boolean                      @default(false)
  id                      String                       @id @default(cuid())
  name                    String
  timeZone                String
  createdAt               DateTime                     @default(now()) @db.Timestamptz(3)
  days                    AttendancePolicyDay[]
  assignments             AttendancePolicyAssignment[]
}

model AttendancePolicyDay {
  policyId        String
  policy          AttendancePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  weekday         Int
  isWorkingDay    Boolean
  requiredMinutes Int

  @@id([policyId, weekday])
}

model AttendancePolicyAssignment {
  id             String              @id @default(cuid())
  employeeId     String
  employee       Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  policyId       String
  policy         AttendancePolicy    @relation(fields: [policyId], references: [id], onDelete: Restrict)
  effectiveFrom  DateTime            @db.Date
  effectiveUntil DateTime?           @db.Date
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  workdays       AttendanceWorkday[]
  leaveRequestDays LeaveRequestDay[]

  @@unique([id, employeeId])
  @@index([employeeId, effectiveFrom])
}

model AttendanceWorkday {
  policyName              String
  unpaidBreaksEnabled     Boolean
  overnightRequiresReview Boolean
  id                      String                     @id @default(cuid())
  employeeId              String
  employee                Employee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignmentId            String
  assignment              AttendancePolicyAssignment @relation(fields: [assignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  workDate                DateTime                   @db.Date
  timeZone                String
  isWorkingDay            Boolean
  requiredMinutes         Int
  createdAt               DateTime                   @default(now()) @db.Timestamptz(3)
  sessions                AttendanceWorkSession[]
  audit                   AttendanceAudit[]

  @@unique([employeeId, workDate])
  @@unique([id, employeeId])
}

model AttendanceWorkSession {
  adjustments AttendanceAdjustment[]
  id          String                 @id @default(cuid())
  // A BEFORE INSERT trigger selects/creates the starting workday if omitted.
  workdayId   String                 @default(dbgenerated())
  employeeId  String
  workday     AttendanceWorkday      @relation(fields: [workdayId, employeeId], references: [id, employeeId], onDelete: Restrict)
  startedAt   DateTime               @db.Timestamptz(3)
  endedAt     DateTime?              @db.Timestamptz(3)
  breaks      AttendanceBreak[]

  @@index([workdayId, startedAt])
  @@index([employeeId, startedAt])
}

model AttendanceBreak {
  id        String                @id @default(cuid())
  sessionId String
  session   AttendanceWorkSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  startedAt DateTime              @db.Timestamptz(3)
  endedAt   DateTime?             @db.Timestamptz(3)
  isPaid    Boolean               @default(false)

  @@index([sessionId, startedAt])
}

model AttendanceAudit {
  id         String             @id @default(cuid())
  // Stable entity identity and snapshots also cover policy/rule/assignment changes.
  entityType String
  entityId   String
  employeeId String?
  employee   Employee?          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workdayId  String?
  workday    AttendanceWorkday? @relation(fields: [workdayId], references: [id], onDelete: Restrict)
  actorId    String?
  actor      User?              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  reason     String
  before     Json?
  after      Json?
  actionId   String             @unique
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)

  @@index([workdayId, createdAt])
  @@index([employeeId, createdAt])
  @@index([entityType, entityId, createdAt])
}

enum AttendanceAdjustmentStatus {
  PENDING
  VERIFIED
  APPROVED
  REJECTED
}

model AttendanceAdjustment {
  notifications     WorkflowNotification[]
  type              String                     @default("CORRECTION") @db.VarChar(20)
  overtimeMinutes   Int                        @default(0)
  verifiedById      String?
  verifiedBy        User?                      @relation("AttendanceVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  verifiedAt        DateTime?                  @db.Timestamptz(3)
  verificationNote  String?                    @db.VarChar(2000)
  id                String                     @id @default(cuid())
  requestKey        String                     @unique
  employeeId        String
  employee          Employee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  sessionId         String?
  session           AttendanceWorkSession?     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  originalSession   Json?
  proposedStartedAt DateTime                   @db.Timestamptz(3)
  proposedEndedAt   DateTime                   @db.Timestamptz(3)
  reason            String                     @db.VarChar(2000)
  status            AttendanceAdjustmentStatus @default(PENDING)
  requestedById     String
  requestedBy       User                       @relation("AttendanceRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById      String?
  reviewedBy        User?                      @relation("AttendanceReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewNote        String?                    @db.VarChar(2000)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  reviewedAt        DateTime?                  @db.Timestamptz(3)

  @@index([employeeId, createdAt, id])
  @@index([status, createdAt, id])
}
