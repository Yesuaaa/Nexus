  updatedAt     DateTime                @updatedAt @db.Timestamptz(3)

  @@unique([employeeId, effectiveFrom], map: "employee_compensation_employee_start_uq")
  @@index([employeeId, effectiveFrom], map: "employee_compensation_timeline_idx")
  @@index([effectiveFrom, effectiveTo], map: "employee_compensation_effective_idx")
}

model CompensationComponent {
  id              String                      @id @default(cuid())
  compensationId  String
  compensation    EmployeeCompensation        @relation(fields: [compensationId], references: [id], onDelete: Cascade)
  type            CompensationComponentType
  name            String                      @db.VarChar(80)
  amount          Decimal                     @db.Decimal(12, 2)
  calculationType CompensationCalculationType @default(FIXED)
  createdAt       DateTime                    @default(now()) @db.Timestamptz(3)

  @@index([compensationId, type], map: "compensation_component_type_idx")
}

model PayrollPreferences {
