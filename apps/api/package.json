{
  "name": "@nexus/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "prisma generate && node node_modules/typescript/lib/tsc.js",
    "typecheck": "prisma generate && node node_modules/typescript/lib/tsc.js --noEmit",
    "test": "prisma generate && node node_modules/typescript/lib/tsc.js && node --test dist/auth.test.js",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:seed": "prisma generate && node node_modules/typescript/lib/tsc.js && prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "prisma": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0"
  }
}
