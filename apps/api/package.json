{
  "name": "@nexus/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "prisma generate && node node_modules/typescript/lib/tsc.js",
    "typecheck": "prisma generate && node node_modules/typescript/lib/tsc.js --noEmit -p tests/tsconfig.json",
    "test": "prisma generate && node node_modules/typescript/lib/tsc.js --noEmit -p tests/tsconfig.json && tsx --test \"tests/**/*.test.ts\"",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:seed": "prisma generate && prisma db seed",
    "db:seed:services": "prisma generate && tsx prisma/seed.ts --services-only",
    "db:migrate": "prisma migrate dev",
    "db:studio": "node -e \"process.env.DATABASE_URL = process.env.DIRECT_URL; require('child_process').spawn('npx', ['prisma', 'studio'], { stdio: 'inherit', shell: true })\"",
    "test:project-chat": "prisma generate && tsx --test tests/project-conversations.test.ts",
    "test:calendar": "prisma generate && tsx --test tests/calendar.test.ts",
    "test:regression": "pnpm test",
    "test:smoke": "prisma generate && tsx --test tests/backend-regression.test.ts",
    "test:api-regression": "prisma generate && tsx --test tests/backend-regression.test.ts tests/api-system-regression.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "jose": "^6.2.13",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "prisma": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0"
  }
}
