# Matches the PostgreSQL service in compose.yaml when running API or Prisma on the host.
DATABASE_URL="postgresql://nexus:nexus_dev@127.0.0.1:5433/nexus_dev?sslmode=disable"
DIRECT_URL="postgresql://nexus:nexus_dev@127.0.0.1:5433/nexus_dev?sslmode=disable"
# Optional strong password shared by the four local accounts created by db:seed:dev.
DEV_SEED_PASSWORD=
PORT=3001
WEB_ORIGIN="http://localhost:5173"
# Server-only JWT key. Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Required for API startup. Do not commit the generated value or expose it to the browser.
JWT_SECRET=
# Server-only Supabase credentials for Storage and private Realtime messaging.
# The API creates or reconciles this public bucket on the first image upload.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_IMAGES_BUCKET="service-images"
# Optional: set both values to seed an ADMIN account after the first Superadmin exists.
# ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
# ADMIN_BOOTSTRAP_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"

# Optional: lookup public sign-in IP city/country using https://ipapi.co/api/
# Sends the public source IP to ipapi; never stores that IP in session records.
# Failure/private IP/provider disabled shows unknown location. Existing sessions stay unknown.
SESSION_GEOLOCATION=
# Optional: comma-separated actual trusted reverse-proxy IPs/CIDRs only.
# Leave blank for direct requests. Proxy must overwrite forwarded headers.
# Do not trust a client-provided X-Forwarded-For header or broad public networks.
TRUST_PROXY=

# Payroll local simulator. Development only and off by default.
PAYROLL_LOCAL_SIMULATOR=false
# Request workflow payment simulator. Development and test only.
WORKFLOW_LOCAL_PAYMENT_SIMULATOR=false
# Reserved for a future, explicitly enabled PayMongo test integration.
PAYMONGO_TEST_SECRET_KEY=
PAYMONGO_TEST_WALLET_ACCOUNT_NUMBER=
PAYMONGO_TEST_WEBHOOK_SIGNING_SECRET=

NODE_ENV=development
