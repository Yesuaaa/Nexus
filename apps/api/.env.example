# Copy the two connection strings from Supabase > Connect.
# Runtime: Transaction pooler (port 6543); keep pgbouncer=true.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require"
# Prisma CLI and migrations: Direct connection (port 5432).
# If your network has no IPv6, Supabase's Session pooler (port 5432) is an alternative.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
PORT=3001
WEB_ORIGIN="http://localhost:5173"
