# Copy the two connection strings from Supabase > Connect.
# Download your database CA certificate from Supabase Database Settings > SSL Configuration.
# Use its absolute, URL-encoded path for sslrootcert in both URLs.
# Runtime: Transaction pooler (port 6543); keep pgbouncer=true.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=verify-full&sslrootcert=URL_ENCODED_ABSOLUTE_CA_PATH"
# Prisma CLI and migrations: Direct connection (port 5432).
# If your network has no IPv6, Supabase's Session pooler (port 5432) is an alternative.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=URL_ENCODED_ABSOLUTE_CA_PATH"
PORT=3001
WEB_ORIGIN="http://localhost:5173"
API_PUBLIC_URL="http://localhost:3001"
# Optional provider sign-in credentials. Keep secrets in the API environment only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Apple .p8 PEM key; preserve line breaks, or use escaped newlines in a single-line environment editor.
APPLE_PRIVATE_KEY=
# Used only when provider sign-in needs an email verification code.
RESEND_API_KEY=
EMAIL_FROM="Nexus <login@example.com>"
# Optional: set both values to seed an ADMIN account after the first Superadmin exists.
# ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
# ADMIN_BOOTSTRAP_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"
