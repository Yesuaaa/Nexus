# Next.js forwards same-origin /api requests to the existing Express API.
# Set this before building for a remote or containerized API (server only).
API_PROXY_TARGET=http://localhost:3001

# Optional: call a public API origin directly instead of the same-origin proxy.
# Use an origin such as https://api.example.com, without an /api suffix.
# This value is bundled into browser code at build time. Never put secrets here.
NEXT_PUBLIC_API_URL=
